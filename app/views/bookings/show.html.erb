<% content_for :title, @booking.code %>

<section class="mx-auto max-w-2xl px-5 py-12">
  <% if @booking.pending? %>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-600 text-2xl text-white">✓</div>
      <h1 class="mt-3 font-display text-2xl font-semibold text-sand-900"><%= t("booking.received_title") %></h1>
      <p class="mt-1 text-sand-600"><%= t("booking.received_subtitle") %></p>
    </div>
  <% end %>

  <div class="mt-6 overflow-hidden rounded-2xl border border-sand-200 bg-white">
    <div class="flex items-center justify-between bg-brand-950 px-6 py-4 text-white">
      <div>
        <p class="text-xs text-brand-300"><%= t("booking.code_label") %></p>
        <p class="font-display text-xl font-bold tracking-wider"><%= @booking.code %></p>
      </div>
      <span class="rounded-full px-3 py-1 text-xs font-medium <%= status_badge_classes(@booking.status) %>">
        <%= status_label(@booking.status) %>
      </span>
    </div>

    <div class="space-y-4 p-6">
      <div>
        <h2 class="font-display font-semibold text-sand-900"><%= @booking.property.name %></h2>
        <p class="flex items-center gap-1 text-sm text-sand-500"><%= icon :pin, klass: "h-3.5 w-3.5 text-sand-400" %><%= @booking.property.address_area %></p>
      </div>

      <div class="grid grid-cols-3 gap-4 text-sm">
        <div><p class="text-sand-500"><%= t("booking.arrival") %></p><p class="font-medium text-sand-900"><%= l @booking.check_in, format: :long %></p></div>
        <div><p class="text-sand-500"><%= t("booking.departure") %></p><p class="font-medium text-sand-900"><%= l @booking.check_out, format: :long %></p></div>
        <div><p class="text-sand-500"><%= t("booking.guests") %></p><p class="font-medium text-sand-900"><%= @booking.guests_count %></p></div>
      </div>

      <div class="space-y-2 border-t border-sand-100 pt-4 text-sm">
        <div class="flex justify-between text-sand-600"><span><%= t("price.lodging") %> · <%= nights_label(@booking.nights) %></span><span><%= money(@booking.subtotal_cents, @booking.currency) %></span></div>
        <div class="flex justify-between text-sand-600"><span><%= t("price.cleaning") %></span><span><%= money(@booking.cleaning_fee_cents, @booking.currency) %></span></div>
        <div class="flex justify-between border-t border-sand-200 pt-2 font-semibold text-sand-900"><span><%= t("price.total") %></span><span><%= money(@booking.total_cents, @booking.currency) %></span></div>
        <div class="flex justify-between text-emerald-800"><span><%= t("price.deposit_short") %></span><span><%= money(@booking.deposit_cents, @booking.currency) %></span></div>
      </div>

      <% if @booking.cancelled? %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"><%= t("booking.cancelled_notice") %></div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 text-center">
    <%= link_to whatsapp_url(t("whatsapp.booking_message", code: @booking.code, property: @booking.property.name)),
          target: "_blank", rel: "noopener",
          class: "inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-5 py-3 font-semibold text-white hover:brightness-105" do %>
      <span class="inline-block h-2 w-2 rounded-full bg-white/90"></span>
      <%= t("booking.coordinate_whatsapp") %>
    <% end %>
    <p class="mt-2 text-sm text-sand-500"><%= t("booking.mention_code_html", code: @booking.code) %></p>
  </div>
</section>
