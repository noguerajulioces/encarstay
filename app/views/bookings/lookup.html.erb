<% content_for :title, t("reservation_lookup.title") %>
<% content_for :description, t("reservation_lookup.subtitle") %>

<section class="mx-auto max-w-2xl px-5 py-16 sm:py-24">
  <div class="text-center">
    <span class="inline-flex items-center gap-2 rounded-full border border-sand-200 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-widest text-sand-500">
      <%= icon :ticket, klass: "h-4 w-4" %> <%= t("layout.nav_my_booking") %>
    </span>
    <h1 class="mt-4 font-display text-3xl font-semibold text-sand-900 sm:text-4xl"><%= t("reservation_lookup.title") %></h1>
    <p class="mt-3 text-sand-500"><%= t("reservation_lookup.subtitle") %></p>
  </div>

  <div class="mt-8 rounded-3xl border border-sand-200 bg-white p-6 shadow-[0_18px_44px_-30px_rgba(0,0,0,0.5)] sm:p-8">
    <%= form_with url: "#", method: :get, data: { controller: "redirect", redirect_template_value: booking_path(":code"), action: "submit->redirect#go" }, class: "flex flex-col gap-3 sm:flex-row" do %>
      <div class="relative flex-1">
        <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sand-400"><%= icon :ticket, klass: "h-5 w-5" %></span>
        <input type="text" data-redirect-target="input" placeholder="RES-XXXX" autofocus
               class="w-full rounded-xl border border-sand-300 bg-white py-3 pl-11 pr-4 text-sand-900 uppercase placeholder:normal-case placeholder:text-sand-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200" />
      </div>
      <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-600">
        <%= icon :search, klass: "h-5 w-5" %> <%= t("reservation_lookup.submit") %>
      </button>
    <% end %>
    <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-sand-500">
      <span class="mt-0.5 text-sand-400"><%= icon :info, klass: "h-4 w-4" %></span>
      <%= t("reservation_lookup.help") %>
    </p>
  </div>

  <p class="mt-6 text-center text-sm text-sand-500">
    <%= t("reservation_lookup.whatsapp_prompt") %>
    <%= link_to t("reservation_lookup.whatsapp_link"), whatsapp_url(t("whatsapp.default_message")),
          target: "_blank", rel: "noopener",
          class: "inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-800" %>
  </p>
</section>
