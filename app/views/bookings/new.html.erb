<% content_for :title, "#{t('property.book')} · #{@property.name}" %>

<h1 class="text-2xl font-semibold text-stone-900"><%= t("booking.new_title") %></h1>
<p class="text-stone-500 mt-1"><%= t("booking.new_subtitle") %></p>

<div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-8">
  <%# --- Guest form --- %>
  <div class="lg:col-span-2 order-2 lg:order-1">
    <%= form_with model: @booking, url: bookings_path, class: "space-y-5" do |form| %>
      <% if @booking.errors.any? %>
        <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
          <ul class="list-disc list-inside">
            <% @booking.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
          </ul>
        </div>
      <% end %>

      <%= form.hidden_field :property_id, value: @property.id %>
      <%= form.hidden_field :check_in %>
      <%= form.hidden_field :check_out %>
      <%= form.hidden_field :guests_count %>

      <%# Honeypot — hidden from humans, tempting to bots. %>
      <div class="hidden" aria-hidden="true">
        <label><%= t("booking.honeypot") %><%= text_field_tag :company, nil, tabindex: -1, autocomplete: "off" %></label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <%= form.label :guest_name, t("booking.guest_name"), class: "block text-sm font-medium text-stone-700 mb-1" %>
          <%= form.text_field :guest_name, required: true, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
        </div>
        <div>
          <%= form.label :guest_email, t("booking.email"), class: "block text-sm font-medium text-stone-700 mb-1" %>
          <%= form.email_field :guest_email, required: true, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
        </div>
        <div>
          <%= form.label :guest_phone, t("booking.phone"), class: "block text-sm font-medium text-stone-700 mb-1" %>
          <%= form.telephone_field :guest_phone, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
        </div>
        <div class="sm:col-span-2">
          <%= form.label :notes, t("booking.notes"), class: "block text-sm font-medium text-stone-700 mb-1" %>
          <%= form.text_area :notes, rows: 3, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
        </div>
      </div>

      <p class="text-xs text-stone-500">
        <%= t("booking.disclaimer_html").html_safe %>
      </p>

      <%= form.submit t("booking.submit"), class: "w-full sm:w-auto rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-6 py-3 cursor-pointer" %>
    <% end %>
  </div>

  <%# --- Summary --- %>
  <div class="lg:col-span-1 order-1 lg:order-2">
    <div class="rounded-2xl border border-stone-200 bg-white p-5">
      <div class="flex gap-3">
        <div class="h-16 w-16 shrink-0 rounded-lg overflow-hidden">
          <% if @property.cover_photo %>
            <%= image_tag @property.cover_photo.image.variant(resize_to_fill: [ 128, 128 ]), class: "h-full w-full object-cover" %>
          <% else %>
            <div class="h-full w-full bg-emerald-800 flex items-center justify-center text-white font-semibold"><%= @property.name.first %></div>
          <% end %>
        </div>
        <div>
          <h2 class="font-semibold text-stone-900"><%= @property.name %></h2>
          <p class="text-sm text-stone-500"><%= @property.address_area %></p>
        </div>
      </div>

      <div class="mt-4 pt-4 border-t border-stone-100 text-sm text-stone-600 space-y-1">
        <div class="flex justify-between"><span><%= t("booking.arrival") %></span><span class="text-stone-900"><%= l @booking.check_in, format: :long if @booking.check_in %></span></div>
        <div class="flex justify-between"><span><%= t("booking.departure") %></span><span class="text-stone-900"><%= l @booking.check_out, format: :long if @booking.check_out %></span></div>
        <div class="flex justify-between"><span><%= t("booking.guests") %></span><span class="text-stone-900"><%= @booking.guests_count %></span></div>
      </div>

      <% if @quote.valid? %>
        <div class="mt-4 pt-4 border-t border-stone-100">
          <%= render "shared/price_breakdown", quote: @quote %>
        </div>
      <% end %>
    </div>
  </div>
</div>
