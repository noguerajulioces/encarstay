<% content_for :title, "Disponibilidad" %>

<div class="bg-white rounded-2xl p-4 sm:p-5 border border-stone-200">
  <%= render "shared/search_form", search: @search %>
</div>

<div class="mt-8">
  <% if !@search.valid_range? %>
    <div class="rounded-xl bg-amber-50 border border-amber-200 text-amber-800 px-4 py-3 text-sm">
      Elegí una fecha de llegada y otra de salida para ver disponibilidad.
    </div>
  <% elsif @results.empty? %>
    <div class="text-center py-12">
      <h2 class="text-xl font-semibold text-stone-900">No hay disponibilidad para esas fechas</h2>
      <p class="text-stone-500 mt-1">Probá con otras fechas o menos huéspedes.</p>
    </div>
  <% else %>
    <h2 class="text-2xl font-semibold text-stone-900">
      <%= pluralize(@results.size, "propiedad disponible", "propiedades disponibles") %>
    </h2>
    <p class="text-stone-500 mt-1">
      <%= l @search.check_in, format: :long %> → <%= l @search.check_out, format: :long %> ·
      <%= nights_label(@search.nights) %> · <%= pluralize(@search.guests, "huésped", "huéspedes") %>
    </p>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @results.each do |property| %>
        <% quote = property.quote(@search.check_in, @search.check_out) %>
        <div class="rounded-2xl overflow-hidden bg-white border border-stone-200 flex flex-col">
          <%= link_to property_path(property, check_in: @search.check_in, check_out: @search.check_out),
                class: "block aspect-[4/3] overflow-hidden" do %>
            <% if property.cover_photo %>
              <%= image_tag property.cover_photo.image.variant(resize_to_fill: [ 640, 480 ]), class: "h-full w-full object-cover" %>
            <% else %>
              <div class="h-full w-full bg-gradient-to-br from-emerald-600 to-emerald-900 flex items-center justify-center text-white text-4xl font-semibold"><%= property.name.first %></div>
            <% end %>
          <% end %>
          <div class="p-4 flex-1 flex flex-col">
            <h3 class="font-semibold text-stone-900"><%= property.name %></h3>
            <p class="text-sm text-stone-500"><%= property.address_area %> · hasta <%= property.capacity %> huéspedes</p>
            <div class="mt-3 pt-3 border-t border-stone-100">
              <p class="text-sm text-stone-500">Total <%= nights_label(@search.nights) %> + limpieza</p>
              <p class="text-lg font-semibold text-stone-900"><%= money(quote.total_cents, quote.currency) %></p>
            </div>
            <%= link_to "Ver y reservar",
                  new_booking_path(property_slug: property.slug, check_in: @search.check_in, check_out: @search.check_out, guests: @search.guests),
                  class: "mt-4 block text-center rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-4 py-2.5" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
