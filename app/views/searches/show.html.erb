<% content_for :title, t("search.title") %>

<section class="mx-auto max-w-6xl px-5 py-10">
  <div class="rounded-2xl border border-sand-200 bg-white p-2 shadow-[0_18px_40px_-30px_rgba(94,72,50,0.5)]">
    <%= render "shared/search_form", search: @search %>
  </div>

  <div class="mt-10">
    <% if !@search.valid_range? %>
      <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        <%= t("search.prompt") %>
      </div>
    <% elsif @results.empty? %>
      <div class="py-16 text-center">
        <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-sand-100 text-sand-400"><%= icon :search, klass: "h-6 w-6" %></span>
        <h2 class="mt-4 font-display text-2xl font-semibold text-brand-900"><%= t("search.none_title") %></h2>
        <p class="mt-1 text-sand-500"><%= t("search.none_subtitle") %></p>
      </div>
    <% else %>
      <h2 class="font-display text-3xl font-semibold text-brand-900">
        <%= t("search.results_count", count: @results.size) %>
      </h2>
      <p class="mt-1 flex flex-wrap items-center gap-1.5 text-sand-500">
        <%= icon :calendar, klass: "h-4 w-4 text-brand-500" %>
        <%= l @search.check_in, format: :long %> → <%= l @search.check_out, format: :long %>
        <span class="text-sand-300">·</span> <%= nights_label(@search.nights) %>
        <span class="text-sand-300">·</span> <%= guests_label(@search.guests) %>
      </p>

      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% @results.each do |property| %>
          <% quote = property.quote(@search.check_in, @search.check_out) %>
          <div class="group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-[0_2px_10px_-6px_rgba(94,72,50,0.25)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_44px_-24px_rgba(94,72,50,0.55)]">
            <%= link_to property_path(property, check_in: @search.check_in, check_out: @search.check_out),
                  class: "relative block aspect-[4/3] overflow-hidden" do %>
              <% if property.cover_photo %>
                <%= image_tag property.cover_photo.image.variant(resize_to_fill: [ 640, 480 ]), alt: property.name, loading: "lazy", class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]" %>
              <% else %>
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-500 to-brand-800 font-display text-4xl font-semibold text-brand-50"><%= property.name.first %></div>
              <% end %>
              <% if property.address_area.present? %>
                <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-brand-800 shadow-sm backdrop-blur">
                  <%= icon :pin, klass: "h-3.5 w-3.5" %><%= property.address_area %>
                </span>
              <% end %>
            <% end %>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-display text-lg font-semibold text-brand-900"><%= property.name %></h3>
              <p class="mt-1 flex items-center gap-1 text-sm text-sand-500"><%= icon :users, klass: "h-4 w-4 text-sand-400" %><%= t("search.up_to_guests", count: property.capacity) %></p>
              <div class="mt-4 border-t border-sand-100 pt-4">
                <p class="text-xs uppercase tracking-wide text-sand-400"><%= t("search.total_summary", nights: nights_label(@search.nights)) %></p>
                <p class="font-display text-xl font-semibold text-brand-900"><%= money(quote.total_cents, quote.currency) %></p>
              </div>
              <%= link_to new_booking_path(property_slug: property.slug, check_in: @search.check_in, check_out: @search.check_out, guests: @search.guests),
                    class: "mt-4 flex items-center justify-center gap-2 rounded-xl bg-brand-700 px-4 py-2.5 font-semibold text-white transition-colors hover:bg-brand-800" do %>
                <%= t("search.view_and_book") %> <%= icon :arrow, klass: "h-4 w-4" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
