<% content_for :title, t("search.title") %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<% end %>

<%
  property_markers = @map_properties.map do |property|
    {
      name:  property.name,
      url:   property_path(property, check_in: @search.check_in, check_out: @search.check_out),
      area:  property.address_area,
      price: money(property.base_price_cents, property.currency),
      thumb: (property.cover_photo ? url_for(property.cover_photo.image.variant(resize_to_fill: [ 200, 130 ])) : nil),
      lat:   property.latitude.to_f,
      lng:   property.longitude.to_f
    }
  end

  poi_marker = ->(entry) do
    {
      title:         entry.title,
      url:           guide_entry_path(entry),
      category_slug: entry.category&.slug,
      category_name: entry.category&.name,
      area:          entry.area,
      thumb:         (entry.cover_image.attached? ? url_for(entry.cover_image.variant(resize_to_fill: [ 200, 130 ])) : nil),
      lat:           entry.latitude.to_f,
      lng:           entry.longitude.to_f
    }
  end
  attraction_markers = @map_attractions.map(&poi_marker)
  event_markers      = @map_events.map(&poi_marker)
%>

<section class="mx-auto max-w-7xl px-5 py-8">
  <div class="rounded-2xl border border-sand-200 bg-white p-2 shadow-[0_18px_40px_-30px_rgba(94,72,50,0.5)]">
    <%= render "shared/search_form", search: @search %>
  </div>

  <div data-controller="search-map"
       data-search-map-properties-value="<%= property_markers.to_json %>"
       data-search-map-attractions-value="<%= attraction_markers.to_json %>"
       data-search-map-events-value="<%= event_markers.to_json %>"
       class="mt-8 grid gap-6 lg:grid-cols-12">

    <%# ---- Left: list of stays ---- %>
    <div class="lg:col-span-7">
      <% if @search.valid_range? %>
        <h1 class="font-display text-3xl font-semibold text-brand-900">
          <%= t("search.results_count", count: @results.size) %>
        </h1>
        <p class="mt-1 flex flex-wrap items-center gap-1.5 text-sand-500">
          <%= icon :calendar, klass: "h-4 w-4 text-brand-500" %>
          <%= l @search.check_in, format: :long %> → <%= l @search.check_out, format: :long %>
          <span class="text-sand-300">·</span> <%= nights_label(@search.nights) %>
          <span class="text-sand-300">·</span> <%= guests_label(@search.guests) %>
        </p>
      <% else %>
        <h1 class="font-display text-3xl font-semibold text-brand-900"><%= t("search.all_stays_title") %></h1>
        <p class="mt-1 text-sand-500"><%= t("search.all_stays_subtitle") %></p>
      <% end %>

      <% if @results.empty? %>
        <div class="mt-8 rounded-2xl border border-dashed border-sand-300 py-16 text-center">
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-sand-100 text-sand-400"><%= icon :search, klass: "h-6 w-6" %></span>
          <h2 class="mt-4 font-display text-2xl font-semibold text-brand-900"><%= t("search.none_title") %></h2>
          <p class="mt-1 text-sand-500"><%= t("search.none_subtitle") %></p>
        </div>
      <% else %>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
          <% @results.each do |property| %>
            <%= render "shared/property_card", property: property, check_in: @search.check_in, check_out: @search.check_out %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ---- Right: interactive map ---- %>
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-24 space-y-3">
        <div class="flex flex-wrap gap-2">
          <% [
               [ "properties",  "#74593d", t("search.map_stays") ],
               [ "attractions", "#0f766e", t("search.map_attractions") ],
               [ "events",      "#b91c1c", t("search.map_events") ]
             ].each do |layer, color, label| %>
            <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-sand-200 bg-white px-3 py-1.5 text-sm font-medium text-sand-700 shadow-sm">
              <%= check_box_tag "layer_#{layer}", "1", true, data: { action: "change->search-map#toggleLayer", layer: layer }, class: "rounded border-sand-300 text-brand-700 focus:ring-brand-500" %>
              <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-full" style="background: <%= color %>"></span><%= label %></span>
            </label>
          <% end %>
        </div>

        <% if @poi_categories.any? %>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" aria-pressed="true" data-action="click->search-map#filterCategory" data-category=""
                    class="rounded-full border border-sand-200 bg-white px-3 py-1 text-xs font-semibold text-sand-600 hover:border-brand-300 aria-pressed:border-brand-700 aria-pressed:bg-brand-700 aria-pressed:text-white cursor-pointer">
              <%= t("search.map_all_categories") %>
            </button>
            <% @poi_categories.each do |category| %>
              <button type="button" aria-pressed="false" data-action="click->search-map#filterCategory" data-category="<%= category.slug %>"
                      class="inline-flex items-center gap-1 rounded-full border border-sand-200 bg-white px-3 py-1 text-xs font-semibold text-sand-600 hover:border-brand-300 aria-pressed:border-brand-700 aria-pressed:bg-brand-700 aria-pressed:text-white cursor-pointer">
                <%= icon(category.icon.presence&.to_sym || :sparkles, klass: "h-3.5 w-3.5") %><%= category.name %>
              </button>
            <% end %>
          </div>
        <% end %>

        <div data-search-map-target="map" class="h-[60vh] w-full overflow-hidden rounded-2xl border border-sand-200 bg-sand-100 lg:h-[75vh]"></div>
      </div>
    </div>
  </div>
</section>
