<% content_for :title, "Guía" %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-sand-900">Guía de la ciudad</h1>
    <p class="mt-1 text-sm text-sand-500">Eventos y lugares que atraen visitas y se enlazan con tus alojamientos.</p>
  </div>
  <%= link_to "+ Nuevo", new_admin_guide_entry_path(kind: @kind), class: "rounded-lg bg-brand-500 hover:bg-brand-600 text-white text-sm font-medium px-4 py-2.5" %>
</div>

<div class="mt-5 flex gap-1 border-b border-sand-200">
  <% { "event" => "Eventos", "attraction" => "Lugares" }.each do |k, label| %>
    <%= link_to admin_guide_entries_path(kind: k),
          class: "px-4 py-2 text-sm font-medium border-b-2 -mb-px #{@kind == k ? 'border-brand-600 text-sand-900' : 'border-transparent text-sand-500 hover:text-sand-800'}" do %>
      <%= label %> <span class="text-sand-400">(<%= @counts[k] || 0 %>)</span>
    <% end %>
  <% end %>
</div>

<div class="mt-5 space-y-2">
  <% @guide_entries.each do |entry| %>
    <%= link_to edit_admin_guide_entry_path(entry), class: "flex items-center gap-4 rounded-xl bg-white border border-sand-200 p-3 hover:shadow-sm" do %>
      <div class="h-14 w-20 shrink-0 overflow-hidden rounded-lg bg-sand-100">
        <% if entry.cover_image.attached? %>
          <%= image_tag entry.cover_image.variant(resize_to_fill: [ 160, 112 ]), class: "h-full w-full object-cover" %>
        <% else %>
          <div class="grid h-full w-full place-items-center text-sand-300"><%= icon(entry.event? ? :ticket : :compass, klass: "h-5 w-5") %></div>
        <% end %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="font-medium text-sand-900 truncate"><%= entry.title_es.presence || "(sin título)" %></p>
        <p class="text-xs text-sand-500 truncate">
          <%= entry.category&.name_es || "Sin categoría" %>
          <% if entry.event? && entry.starts_at %> · <%= l entry.starts_at, format: :short %><% end %>
          <% if entry.area.present? %> · <%= entry.area %><% end %>
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-1.5">
        <% if entry.featured? %><span class="rounded-full bg-amber-100 text-amber-800 text-xs px-2 py-0.5">Destacado</span><% end %>
        <span class="rounded-full text-xs px-2 py-0.5 <%= entry.published? ? 'bg-emerald-100 text-emerald-800' : 'bg-sand-200 text-sand-500' %>">
          <%= entry.published? ? "Publicado" : "Borrador" %>
        </span>
      </div>
    <% end %>
  <% end %>
  <% if @guide_entries.empty? %>
    <div class="rounded-xl border border-dashed border-sand-300 p-10 text-center text-sand-500">
      Todavía no hay <%= @kind == "event" ? "eventos" : "lugares" %>. <%= link_to "Creá el primero", new_admin_guide_entry_path(kind: @kind), class: "text-brand-700 underline" %>.
    </div>
  <% end %>
</div>
