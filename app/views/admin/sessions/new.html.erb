<% content_for :title, "Ingresar" %>

<div class="w-full max-w-sm">
  <div class="text-center mb-6">
    <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-700 text-white text-xl font-semibold">R</span>
    <h1 class="mt-3 text-xl font-semibold text-sand-900">Panel de administración</h1>
    <p class="text-sm text-sand-500">Reservá Directo</p>
  </div>

  <%= form_with url: admin_session_path, method: :post, class: "bg-white rounded-2xl border border-sand-200 p-6 space-y-4" do %>
    <div>
      <label class="block text-sm font-medium text-sand-700 mb-1">Email</label>
      <%= email_field_tag :email, params[:email], required: true, autofocus: true, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-sand-700 mb-1">Contraseña</label>
      <%= password_field_tag :password, nil, required: true, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <%= submit_tag "Ingresar", class: "w-full rounded-lg bg-brand-700 hover:bg-brand-800 text-white font-medium px-4 py-2.5 cursor-pointer" %>
  <% end %>
</div>
