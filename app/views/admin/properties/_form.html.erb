<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<% end %>

<%= form_with model: [ :admin, property ], html: { multipart: true, class: "space-y-5" } do |form| %>
  <% if property.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% property.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white border border-sand-200 p-5 space-y-4">
    <div>
      <%= form.label :name, "Nombre", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.text_field :name, required: true, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <div>
      <%= form.label :property_type, "Tipología", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.select :property_type,
            Property.property_types.keys.map { |k| [ t("property_types.#{k}"), k ] },
            { include_blank: "— Sin tipología —" },
            class: "w-full rounded-lg border-sand-300 border px-3 py-2 bg-white" %>
    </div>

    <div>
      <%= form.label :description, "Descripción", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.text_area :description, rows: 4, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <div>
      <%= form.label :address_area, "Zona / localidad", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.text_field :address_area, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <div data-controller="map-picker">
      <label class="block text-sm font-medium text-sand-700 mb-1">Ubicación en el mapa</label>
      <p class="text-xs text-sand-500 mb-2">Hacé clic en el mapa o arrastrá el pin para ubicar la propiedad. También podés pegar coordenadas de Google Maps en los campos de abajo.</p>
      <div data-map-picker-target="map" class="h-72 w-full rounded-lg border border-sand-300"></div>
      <div class="grid grid-cols-2 gap-4 mt-3">
        <div>
          <%= form.label :latitude, "Latitud", class: "block text-sm font-medium text-sand-700 mb-1" %>
          <%= form.text_field :latitude, placeholder: "-27.33",
                data: { map_picker_target: "latitude", action: "input->map-picker#syncFromInputs" },
                class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
        </div>
        <div>
          <%= form.label :longitude, "Longitud", class: "block text-sm font-medium text-sand-700 mb-1" %>
          <%= form.text_field :longitude, placeholder: "-55.86",
                data: { map_picker_target: "longitude", action: "input->map-picker#syncFromInputs" },
                class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
        </div>
      </div>
      <p class="text-xs text-sand-500 mt-3">Al cambiar las coordenadas, recalculá las distancias por calle con <code>bin/rails distances:refresh</code> (o cargalas a mano abajo).</p>
      <div class="grid grid-cols-2 gap-4 mt-3">
        <div>
          <%= form.label :distance_center_km, "Km al centro (por calle)", class: "block text-sm font-medium text-sand-700 mb-1" %>
          <%= form.number_field :distance_center_km, step: 0.1, min: 0, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
        </div>
        <div>
          <%= form.label :distance_costanera_km, "Km al Shopping Costanera", class: "block text-sm font-medium text-sand-700 mb-1" %>
          <%= form.number_field :distance_costanera_km, step: 0.1, min: 0, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
        </div>
      </div>
    </div>
  </div>

  <div class="rounded-xl bg-white border border-sand-200 p-5 grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div><%= form.label :capacity, "Capacidad", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.number_field :capacity, min: 1, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
    <div><%= form.label :bedrooms, "Dormitorios", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.number_field :bedrooms, min: 0, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
    <div><%= form.label :beds, "Camas", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.number_field :beds, min: 0, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
    <div><%= form.label :bathrooms, "Baños (0,5 = toilette)", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.number_field :bathrooms, min: 0, step: 0.5, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
  </div>

  <div class="rounded-xl bg-white border border-sand-200 p-5 grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div>
      <%= form.label :currency, "Moneda", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.select :currency, Property::CURRENCIES, {}, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <div><%= form.label :base_price, "Precio/noche", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.text_field :base_price, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
    <div><%= form.label :cleaning_fee, "Limpieza", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.text_field :cleaning_fee, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
    <div><%= form.label :min_nights, "Mín. noches", class: "block text-sm font-medium text-sand-700 mb-1" %><%= form.number_field :min_nights, min: 1, class: "w-full rounded-lg border-sand-300 border px-3 py-2" %></div>
  </div>

  <div class="rounded-xl bg-white border border-sand-200 p-5 space-y-4">
    <div>
      <%= form.label :airbnb_listing_url, "URL del calendario del anuncio en Airbnb (para bloqueo manual)", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.url_field :airbnb_listing_url, placeholder: "https://www.airbnb.com/hosting/listings/...", class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
    </div>
    <div>
      <%= form.label :airbnb_public_url, "URL pública del anuncio en Airbnb (visible para huéspedes)", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.url_field :airbnb_public_url, placeholder: "https://www.airbnb.com/rooms/...", class: "w-full rounded-lg border-sand-300 border px-3 py-2" %>
      <p class="mt-1 text-xs text-sand-500">Si se completa, el sitio ofrece "Reservar por Airbnb" como alternativa.</p>
    </div>
    <label class="flex items-center gap-2 text-sm text-sand-700">
      <%= form.check_box :active, class: "rounded border-sand-300" %> Activa (visible en el sitio)
    </label>
  </div>

  <% if Amenity.exists? %>
    <div class="rounded-xl bg-white border border-sand-200 p-5">
      <p class="text-sm font-medium text-sand-700 mb-3">Servicios</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <%= form.collection_check_boxes :amenity_ids, Amenity.ordered, :id, :label do |b| %>
          <label class="flex items-center gap-2 text-sm text-sand-700">
            <%= b.check_box class: "rounded border-sand-300" %> <%= b.text %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if property.persisted? %>
    <div class="rounded-xl bg-white border border-sand-200 p-5">
      <%= form.label :photos, "Agregar fotos", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= file_field_tag "photos[]", multiple: true, accept: "image/*", class: "text-sm" %>
    </div>
  <% end %>

  <div class="flex gap-3">
    <%= form.submit property.persisted? ? "Guardar cambios" : "Crear propiedad", class: "rounded-lg bg-brand-500 hover:bg-brand-600 text-white font-medium px-5 py-2.5 cursor-pointer" %>
    <%= link_to "Cancelar", property.persisted? ? admin_property_path(property) : admin_properties_path, class: "rounded-lg border border-sand-300 text-sand-700 px-5 py-2.5" %>
  </div>
<% end %>
