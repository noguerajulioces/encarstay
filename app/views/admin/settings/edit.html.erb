<% content_for :title, "Configuración" %>
<% inp = "w-full rounded-lg border-sand-300 border px-3 py-2" %>

<div class="max-w-2xl">
  <h1 class="text-2xl font-semibold text-sand-900 mb-5">Configuración</h1>

  <%= form_with model: @setting, url: admin_settings_path, method: :patch, class: "space-y-5" do |form| %>
    <% if @setting.errors.any? %>
      <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
        <ul class="list-disc list-inside">
          <% @setting.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
        </ul>
      </div>
    <% end %>

    <div class="rounded-xl bg-white border border-sand-200 p-5 space-y-4">
      <div>
        <%= form.label :whatsapp_number, "Número de WhatsApp", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.text_field :whatsapp_number, placeholder: "595981000000", class: inp %>
        <p class="mt-1 text-xs text-sand-400">Con código de país, solo dígitos (sin +, espacios ni guiones). Es el número al que escriben los clientes.</p>
      </div>
    </div>

    <div class="flex gap-3">
      <%= form.submit "Guardar cambios", class: "rounded-lg bg-brand-500 hover:bg-brand-600 text-white font-medium px-5 py-2.5 cursor-pointer" %>
    </div>
  <% end %>
</div>
