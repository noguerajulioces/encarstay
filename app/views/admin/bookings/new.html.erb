<% content_for :title, "Nueva reserva manual" %>
<nav class="text-sm text-stone-500 mb-4"><%= link_to "← Reservas", admin_bookings_path, class: "hover:text-emerald-700" %></nav>
<h1 class="text-2xl font-semibold text-stone-900 mb-1">Nueva reserva manual</h1>
<p class="text-stone-500 mb-5">Para reservas tomadas por teléfono o WhatsApp. El precio se calcula automáticamente.</p>

<%= form_with model: @booking, url: admin_bookings_path, class: "max-w-2xl space-y-5" do |form| %>
  <% if @booking.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% @booking.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white border border-stone-200 p-5 space-y-4">
    <div>
      <%= form.label :property_id, "Propiedad", class: "block text-sm font-medium text-stone-700 mb-1" %>
      <%= form.collection_select :property_id, @properties, :id, :name, {}, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div><%= form.label :check_in, "Llegada", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.date_field :check_in, required: true, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
      <div><%= form.label :check_out, "Salida", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.date_field :check_out, required: true, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
      <div><%= form.label :guests_count, "Huéspedes", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.number_field :guests_count, min: 1, value: @booking.guests_count, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
    </div>
  </div>

  <div class="rounded-xl bg-white border border-stone-200 p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="sm:col-span-2"><%= form.label :guest_name, "Nombre del huésped", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.text_field :guest_name, required: true, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
    <div><%= form.label :guest_email, "Email", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.email_field :guest_email, required: true, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
    <div><%= form.label :guest_phone, "Teléfono", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.telephone_field :guest_phone, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
    <div class="sm:col-span-2"><%= form.label :notes, "Notas", class: "block text-sm font-medium text-stone-700 mb-1" %><%= form.text_area :notes, rows: 2, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %></div>
  </div>

  <%= form.submit "Crear reserva", class: "rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-5 py-2.5 cursor-pointer" %>
<% end %>
