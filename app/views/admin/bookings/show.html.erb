<% content_for :title, @booking.code %>

<nav class="text-sm text-stone-500 mb-4"><%= link_to "← Reservas", admin_bookings_path, class: "hover:text-emerald-700" %></nav>

<div class="flex items-start justify-between flex-wrap gap-3">
  <div>
    <h1 class="text-2xl font-semibold text-stone-900 font-mono"><%= @booking.code %></h1>
    <p class="text-stone-500"><%= @booking.property.name %> · <span class="capitalize"><%= @booking.source %></span></p>
  </div>
  <span class="text-sm font-medium px-3 py-1.5 rounded-full <%= status_badge_classes(@booking.status) %>"><%= status_label(@booking.status) %></span>
</div>

<div class="mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <section class="rounded-xl bg-white border border-stone-200 p-5">
      <h2 class="font-semibold text-stone-900 mb-3">Estadía</h2>
      <div class="grid grid-cols-3 gap-4 text-sm">
        <div><p class="text-stone-500">Llegada</p><p class="font-medium"><%= l @booking.check_in, format: :long %></p></div>
        <div><p class="text-stone-500">Salida</p><p class="font-medium"><%= l @booking.check_out, format: :long %></p></div>
        <div><p class="text-stone-500">Noches</p><p class="font-medium"><%= @booking.nights %></p></div>
      </div>
    </section>

    <section class="rounded-xl bg-white border border-stone-200 p-5">
      <h2 class="font-semibold text-stone-900 mb-3">Huésped</h2>
      <div class="space-y-1 text-sm">
        <p><span class="text-stone-500">Nombre:</span> <span class="font-medium"><%= @booking.guest_name %></span> · <%= @booking.guests_count %> huéspedes</p>
        <p><span class="text-stone-500">Email:</span> <%= mail_to @booking.guest_email, class: "text-emerald-700" %></p>
        <% if @booking.guest_phone.present? %>
          <p><span class="text-stone-500">Teléfono:</span>
            <%= link_to @booking.guest_phone, "https://wa.me/#{@booking.guest_phone.gsub(/\D/, '')}", class: "text-emerald-700", target: "_blank", rel: "noopener" %>
          </p>
        <% end %>
        <% if @booking.notes.present? %><p class="text-stone-600 italic mt-2">"<%= @booking.notes %>"</p><% end %>
      </div>
    </section>
  </div>

  <div class="space-y-6">
    <section class="rounded-xl bg-white border border-stone-200 p-5">
      <h2 class="font-semibold text-stone-900 mb-3">Importe</h2>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between text-stone-600"><span>Alojamiento</span><span><%= money(@booking.subtotal_cents, @booking.currency) %></span></div>
        <div class="flex justify-between text-stone-600"><span>Limpieza</span><span><%= money(@booking.cleaning_fee_cents, @booking.currency) %></span></div>
        <div class="flex justify-between font-semibold border-t border-stone-200 pt-2"><span>Total</span><span><%= money(@booking.total_cents, @booking.currency) %></span></div>
        <div class="flex justify-between text-emerald-800"><span>Seña (50%)</span><span><%= money(@booking.deposit_cents, @booking.currency) %></span></div>
      </div>
    </section>

    <% unless @booking.cancelled? || @booking.completed? %>
      <section class="rounded-xl bg-white border border-stone-200 p-5 space-y-3">
        <h2 class="font-semibold text-stone-900">Acciones</h2>

        <% if @booking.property.airbnb_listing_url.present? && @booking.pending? %>
          <%= link_to "Bloquear fechas en Airbnb ↗", @booking.property.airbnb_listing_url, target: "_blank", rel: "noopener",
                class: "block text-center rounded-lg bg-amber-100 text-amber-800 font-medium px-4 py-2.5 hover:bg-amber-200" %>
        <% end %>

        <% if @booking.pending? %>
          <%= button_to "Confirmar reserva", admin_booking_confirmation_path(@booking), method: :post,
                class: "w-full rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-4 py-2.5 cursor-pointer" %>
        <% end %>

        <%= button_to "Cancelar reserva", admin_booking_cancellation_path(@booking), method: :post,
              data: { turbo_confirm: "¿Cancelar esta reserva? Las fechas quedarán libres." },
              class: "w-full rounded-lg border border-rose-300 text-rose-700 font-medium px-4 py-2.5 hover:bg-rose-50 cursor-pointer" %>
      </section>
    <% end %>
  </div>
</div>
