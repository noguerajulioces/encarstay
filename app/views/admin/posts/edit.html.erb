<% content_for :title, @post.title_es %>

<div class="max-w-3xl space-y-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-medium uppercase tracking-wide text-brand-500">Artículo</p>
      <h1 class="text-2xl font-semibold text-sand-900"><%= @post.title_es %></h1>
    </div>
    <div class="flex shrink-0 items-center gap-3 text-sm">
      <%= link_to "Ver en el sitio ↗", post_path(@post), target: "_blank", rel: "noopener", class: "text-brand-700 hover:underline" %>
      <%= button_to "Eliminar", admin_post_path(@post), method: :delete, form: { data: { turbo_confirm: "¿Eliminar este artículo?" } }, class: "text-rose-700 hover:underline cursor-pointer" %>
    </div>
  </div>

  <%= render "form", post: @post %>
</div>
