<%# Trix editor CSS — scoped to this admin page so it never loads on the public site. %>
<% content_for :head do %>
  <%= stylesheet_link_tag "trix" %>
<% end %>

<% inp = "w-full rounded-lg border-sand-300 border px-3 py-2" %>
<% lbl = "block text-sm font-medium text-sand-700 mb-1" %>

<%= form_with model: [ :admin, campaign ], class: "space-y-5" do |form| %>
  <% if campaign.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% campaign.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white border border-sand-200 p-5 space-y-4">
    <div>
      <%= form.label :subject, "Asunto", class: lbl %>
      <%= form.text_field :subject, required: true, class: inp %>
    </div>
    <div>
      <%= form.label :body, "Contenido", class: lbl %>
      <%= form.rich_text_area :body, class: "trix-content min-h-48 rounded-lg border border-sand-300 bg-white" %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= form.submit campaign.persisted? ? "Guardar cambios" : "Crear campaña", class: "rounded-lg bg-brand-500 hover:bg-brand-600 text-white font-medium px-5 py-2.5 cursor-pointer" %>
    <%= link_to "Cancelar", admin_campaigns_path, class: "rounded-lg border border-sand-300 text-sand-700 px-5 py-2.5" %>
  </div>
<% end %>
