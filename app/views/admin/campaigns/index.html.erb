<% content_for :title, "Campañas" %>

<% status_labels = { "draft" => "Borrador", "sending" => "Enviando…", "sent" => "Enviada" } %>
<% status_badges = { "draft" => "bg-sand-200 text-sand-600", "sending" => "bg-amber-100 text-amber-800", "sent" => "bg-emerald-100 text-emerald-800" } %>

<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-sand-900">Campañas</h1>
    <p class="mt-1 text-sm text-sand-500">Boletines a tus <%= @confirmed_count %> suscriptores confirmados.</p>
  </div>
  <%= link_to "+ Nueva campaña", new_admin_campaign_path, class: "rounded-lg bg-brand-500 hover:bg-brand-600 text-white text-sm font-medium px-4 py-2.5" %>
</div>

<div class="mt-5 space-y-2">
  <% @campaigns.each do |campaign| %>
    <%= link_to admin_campaign_path(campaign), class: "flex items-center justify-between gap-4 rounded-xl bg-white border border-sand-200 p-4 hover:shadow-sm" do %>
      <div class="min-w-0">
        <p class="font-medium text-sand-900 truncate"><%= campaign.subject %></p>
        <p class="text-xs text-sand-500">
          <% if campaign.sent? %>Enviada <%= l campaign.sent_at, format: :short %> · <%= campaign.recipients_count %> destinatarios
          <% else %>Creada <%= l campaign.created_at, format: :short %><% end %>
        </p>
      </div>
      <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-medium <%= status_badges[campaign.status] %>"><%= status_labels[campaign.status] %></span>
    <% end %>
  <% end %>
  <% if @campaigns.empty? %>
    <div class="rounded-xl border border-dashed border-sand-300 p-10 text-center text-sand-500">
      Todavía no hay campañas. <%= link_to "Creá la primera", new_admin_campaign_path, class: "text-brand-700 underline" %>.
    </div>
  <% end %>
</div>
