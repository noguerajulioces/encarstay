<% loc_label = { "es" => "Español", "en" => "English", "pt" => "Português" } %>
<% inp = "w-full rounded-lg border-sand-300 border px-3 py-2" %>
<%= form_with model: [ :admin, category ], class: "space-y-5" do |form| %>
  <% if category.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% category.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white border border-sand-200 p-5 space-y-4">
    <div>
      <span class="block text-sm font-medium text-sand-700 mb-1">Nombre <span class="text-sand-400 font-normal">(por idioma)</span></span>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <% %w[es en pt].each do |l| %>
          <div>
            <span class="text-xs text-sand-400"><%= loc_label[l] %></span>
            <%= form.text_field "name_#{l}", required: (l == "es"), class: inp %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :icon, "Ícono", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.select :icon, %w[sparkles compass ticket calendar star pin heart home bed clock], { include_blank: "—" }, class: inp %>
      </div>
      <div>
        <%= form.label :position, "Orden", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.number_field :position, class: inp %>
      </div>
    </div>
  </div>

  <div class="flex gap-3">
    <%= form.submit category.persisted? ? "Guardar cambios" : "Crear categoría", class: "rounded-lg bg-brand-700 hover:bg-brand-800 text-white font-medium px-5 py-2.5 cursor-pointer" %>
    <%= link_to "Cancelar", admin_categories_path, class: "rounded-lg border border-sand-300 text-sand-700 px-5 py-2.5" %>
    <% if category.persisted? %>
      <%= button_to "Eliminar", admin_category_path(category), method: :delete, form: { data: { turbo_confirm: "¿Eliminar esta categoría?" } }, class: "ml-auto rounded-lg text-rose-700 hover:bg-rose-50 px-5 py-2.5 cursor-pointer" %>
    <% end %>
  </div>
<% end %>
