<% inp = "w-full rounded-lg border-sand-300 border px-3 py-2" %>
<%= form_with model: [ :admin, @property, review ], class: "space-y-5" do |form| %>
  <% if review.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm">
      <ul class="list-disc list-inside">
        <% review.errors.full_messages.each { |message| %><li><%= message %></li><% } %>
      </ul>
    </div>
  <% end %>

  <div class="rounded-xl bg-white border border-sand-200 p-5 space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :reviewer_name, "Nombre del huésped", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.text_field :reviewer_name, required: true, class: inp %>
      </div>
      <div>
        <%= form.label :reviewer_location, "Ubicación (opcional)", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.text_field :reviewer_location, placeholder: "Asunción, Paraguay", class: inp %>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :rating, "Puntaje", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.select :rating, (1..5).to_a.reverse, {}, class: inp %>
      </div>
      <div>
        <%= form.label :stayed_on, "Fecha de la estadía", class: "block text-sm font-medium text-sand-700 mb-1" %>
        <%= form.date_field :stayed_on, class: inp %>
      </div>
    </div>
    <div>
      <%= form.label :body, "Comentario", class: "block text-sm font-medium text-sand-700 mb-1" %>
      <%= form.text_area :body, rows: 4, class: inp %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= form.submit review.persisted? ? "Guardar cambios" : "Crear reseña", class: "rounded-lg bg-brand-500 hover:bg-brand-600 text-white font-medium px-5 py-2.5 cursor-pointer" %>
    <%= link_to "Cancelar", admin_property_reviews_path(@property), class: "rounded-lg border border-sand-300 text-sand-700 px-5 py-2.5" %>
  </div>
<% end %>
