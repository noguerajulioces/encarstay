<h1 style="color:#1c1917;"><%= t("mailer.newsletter.confirm.heading") %></h1>

<p><%= t("mailer.newsletter.confirm.intro_html").html_safe %></p>

<p style="margin:24px 0;">
  <a href="<%= newsletter_confirm_url(@subscriber.confirmation_token, locale: @locale_param) %>"
     style="display:inline-block;background:#96754e;color:#fff;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:bold;">
    <%= t("mailer.newsletter.confirm.cta") %>
  </a>
</p>

<p style="color:#78716c;font-size:14px;"><%= t("mailer.newsletter.confirm.footer") %></p>
