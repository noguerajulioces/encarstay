<%= t("mailer.guest_requested.heading", name: @booking.guest_name.split.first) %>

<%= t("mailer.guest_requested.intro_text") %>

<%= t("mailer.guest_requested.code") %>:     <%= @booking.code %>
<%= t("mailer.guest_requested.property") %>:  <%= @booking.property.name %>
<%= t("mailer.guest_requested.arrival") %>:    <%= l @booking.check_in, format: :long %>
<%= t("mailer.guest_requested.departure") %>:    <%= l @booking.check_out, format: :long %>
<%= t("mailer.guest_requested.guests") %>:  <%= @booking.guests_count %>
<%= t("mailer.guest_requested.total") %>:      <%= money(@booking.total_cents, @booking.currency) %>
<%= t("mailer.guest_requested.deposit") %>: <%= money(@booking.deposit_cents, @booking.currency) %>

<%= t("mailer.guest_requested.status_link") %>: <%= booking_url(@booking.code, locale: @locale_param) %>
