<%= t("mailer.confirmed.heading") %>

<%= t("mailer.confirmed.intro_text", name: @booking.guest_name.split.first, property: @booking.property.name) %>

<%= t("mailer.confirmed.code") %>:   <%= @booking.code %>
<%= t("mailer.confirmed.arrival") %>:  <%= l @booking.check_in, format: :long %>
<%= t("mailer.confirmed.departure") %>:  <%= l @booking.check_out, format: :long %>
<%= t("mailer.confirmed.total") %>:    <%= money(@booking.total_cents, @booking.currency) %>

<%= t("mailer.confirmed.cta_text") %>: <%= booking_url(@booking.code, locale: @locale_param) %>
