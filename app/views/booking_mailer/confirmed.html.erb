<h1 style="color:#1c1917;">Tu reserva está confirmada ✓</h1>

<p>¡Todo listo, <%= @booking.guest_name.split.first %>! Confirmamos tu reserva en
<strong><%= @booking.property.name %></strong>. Te esperamos.</p>

<table style="width:100%;border-collapse:collapse;margin:20px 0;">
  <tr><td style="padding:6px 0;color:#78716c;">Código</td><td style="padding:6px 0;text-align:right;font-weight:bold;"><%= @booking.code %></td></tr>
  <tr><td style="padding:6px 0;color:#78716c;">Llegada</td><td style="padding:6px 0;text-align:right;"><%= l @booking.check_in, format: :long %></td></tr>
  <tr><td style="padding:6px 0;color:#78716c;">Salida</td><td style="padding:6px 0;text-align:right;"><%= l @booking.check_out, format: :long %></td></tr>
  <tr><td style="padding:6px 0;color:#78716c;">Total</td><td style="padding:6px 0;text-align:right;font-weight:bold;"><%= money(@booking.total_cents, @booking.currency) %></td></tr>
</table>

<p><a href="<%= booking_url(@booking.code) %>" style="display:inline-block;background:#047857;color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none;">Ver mi reserva</a></p>
