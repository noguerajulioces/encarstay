<h1 style="color:#1c1917;"><%= t("mailer.confirmed.heading") %></h1>

<p><%= t("mailer.confirmed.intro_html", name: @booking.guest_name.split.first, property: @booking.property.name).html_safe %></p>

<table style="width:100%;border-collapse:collapse;margin:20px 0;">
  <tr><td style="padding:6px 0;color:#78716c;"><%= t("mailer.confirmed.code") %></td><td style="padding:6px 0;text-align:right;font-weight:bold;"><%= @booking.code %></td></tr>
  <tr><td style="padding:6px 0;color:#78716c;"><%= t("mailer.confirmed.arrival") %></td><td style="padding:6px 0;text-align:right;"><%= l @booking.check_in, format: :long %></td></tr>
  <tr><td style="padding:6px 0;color:#78716c;"><%= t("mailer.confirmed.departure") %></td><td style="padding:6px 0;text-align:right;"><%= l @booking.check_out, format: :long %></td></tr>
  <% if @booking.discount_cents.positive? %>
    <tr><td style="padding:6px 0;color:#047857;"><%= t("mailer.confirmed.discount") %></td><td style="padding:6px 0;text-align:right;color:#047857;">−<%= money(@booking.discount_cents, @booking.currency) %></td></tr>
  <% end %>
  <tr><td style="padding:6px 0;color:#78716c;"><%= t("mailer.confirmed.total") %></td><td style="padding:6px 0;text-align:right;font-weight:bold;"><%= money(@booking.total_cents, @booking.currency) %></td></tr>
</table>

<p><a href="<%= booking_url(@booking.code, locale: @locale_param) %>" style="display:inline-block;background:#047857;color:#fff;padding:12px 20px;border-radius:8px;text-decoration:none;"><%= t("mailer.confirmed.cta") %></a></p>
