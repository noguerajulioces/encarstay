<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Encar Stays">
    <meta name="application-name" content="Encar Stays">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#fafafa">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= render "shared/meta" %>
    <%= yield :seo %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Self-hosted Plausible analytics — renders only when PLAUSIBLE_DOMAIN is set
        (see docs/PLAUSIBLE.md). Script and events are served first-party through
        our own /plausible proxy; the outbound-links variant also counts clicks
        out to Airbnb and WhatsApp. %>
    <% if ENV["PLAUSIBLE_DOMAIN"].present? %>
      <script defer data-domain="<%= ENV["PLAUSIBLE_DOMAIN"] %>" data-api="/plausible/api/event"
              src="/plausible/js/script.outbound-links.js"></script>
    <% end %>
  </head>

  <%# min-h-full (no h-full): con altura fija de una pantalla, el sticky del
      header solo actúa dentro de ese primer viewport. %>
  <body class="min-h-full bg-sand-50 text-sand-800 antialiased font-sans selection:bg-brand-200 selection:text-sand-900">
    <a href="#contenido"
       class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-white focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-brand-700 focus:shadow-lg">
      <%= t("layout.skip_to_content") %>
    </a>

    <header class="sticky top-0 z-40 border-b border-sand-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-5 sm:px-8 md:h-20">
        <%= link_to root_path, class: "shrink-0 transition-opacity hover:opacity-80", "aria-label": t("site.name") do %>
          <%= image_tag "encar-stays-lockup-green.png", alt: t("site.name"), width: 770, height: 300, class: "hidden h-10 w-auto md:block" %>
          <%= image_tag "encar-stays-symbol-green.png", alt: t("site.name"), width: 288, height: 332, class: "h-9 w-auto md:hidden" %>
        <% end %>

        <%# "Qué hacer" queda activo también en /events: son pestañas del mismo hub. %>
        <% nav_links = [
             [ t("layout.nav_properties"),  properties_path,  %w[properties].include?(controller_name) ],
             [ t("layout.nav_attractions"), attractions_path, %w[attractions events].include?(controller_name) ],
             [ t("layout.nav_blog"),        posts_path,       %w[posts].include?(controller_name) ]
           ] %>

        <nav class="hidden flex-1 items-center justify-center gap-1 md:flex" aria-label="<%= t("layout.menu") %>">
          <% nav_links.each do |label, path, on| %>
            <%= link_to label, path,
                  "aria-current": (on ? "page" : nil),
                  class: "relative rounded-lg px-3 py-2 text-base font-medium transition-colors #{on ? 'text-sand-900 after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-brand-500' : 'text-sand-600 hover:bg-sand-100 hover:text-sand-900'}" %>
          <% end %>
        </nav>

        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
          <%= link_to t("layout.nav_my_booking"), booking_lookup_path,
                class: "hidden rounded-lg px-3 py-2 text-base font-medium text-sand-600 transition-colors hover:bg-sand-100 hover:text-sand-900 lg:block" %>

          <%# Selector de idioma %>
          <div class="relative hidden md:block" data-controller="menu">
            <button type="button" data-menu-target="button" data-action="menu#toggle"
                    aria-haspopup="true" aria-expanded="false" aria-label="<%= t('layout.language') %>"
                    class="flex h-11 items-center gap-1 rounded-xl border border-sand-200 px-3 text-base font-semibold text-sand-700 transition hover:border-sand-300">
              <%= I18n.locale.to_s.upcase %>
              <%= icon :chevron_down, klass: "h-3.5 w-3.5 text-sand-500" %>
            </button>
            <div data-menu-target="panel" hidden
                 class="absolute right-0 top-full z-50 mt-2 w-44 overflow-hidden rounded-2xl border border-sand-200 bg-white py-2 shadow-[0_8px_28px_rgba(0,0,0,0.18)]">
              <% I18n.available_locales.each do |loc| %>
                <% active = (loc == I18n.locale) %>
                <%= link_to path_for_locale(loc), lang: loc, hreflang: loc,
                      "aria-current": (active ? "true" : nil),
                      class: "flex items-center px-4 py-2.5 text-base transition hover:bg-sand-100 #{active ? 'font-semibold text-sand-900' : 'text-sand-700'}" do %>
                  <span><%= t("layout.locale_names.#{loc}", default: loc.to_s.upcase) %></span>
                  <% if active %><span class="ml-auto text-brand-500"><%= icon :check, klass: "h-4 w-4" %></span><% end %>
                <% end %>
              <% end %>
            </div>
          </div>

          <span class="hidden md:block">
            <%= link_to properties_path, class: btn_classes(:primary) do %>
              <%= icon :search, klass: "h-4 w-4" %><%= t("layout.nav_search") %>
            <% end %>
          </span>
          <%= link_to properties_path, "aria-label": t("layout.nav_search"),
                class: "grid h-11 w-11 place-items-center rounded-xl bg-brand-500 text-white transition-colors hover:bg-brand-600 md:hidden" do %>
            <%= icon :search, klass: "h-5 w-5" %>
          <% end %>

          <%# Menú móvil %>
          <div class="relative md:hidden" data-controller="menu">
            <button type="button" data-menu-target="button" data-action="menu#toggle"
                    aria-haspopup="true" aria-expanded="false" aria-label="<%= t('layout.menu') %>"
                    class="grid h-11 w-11 place-items-center rounded-xl border border-sand-200 text-sand-700 transition hover:border-sand-300">
              <%= icon :menu, klass: "h-5 w-5" %>
            </button>
            <div data-menu-target="panel" hidden
                 class="absolute right-0 top-full z-50 mt-2 w-64 overflow-hidden rounded-2xl border border-sand-200 bg-white py-2 shadow-[0_8px_28px_rgba(0,0,0,0.18)]">
              <% (nav_links + [ [ t("layout.nav_my_booking"), booking_lookup_path, current_page?(booking_lookup_path) ] ]).each do |label, path, on| %>
                <%= link_to label, path, "aria-current": (on ? "page" : nil),
                      class: "block px-4 py-2.5 text-base transition hover:bg-sand-100 #{on ? 'font-semibold text-sand-900' : 'text-sand-800'}" %>
              <% end %>
              <div class="mt-2 flex items-center gap-1 border-t border-sand-100 px-4 pt-3 pb-1.5">
                <% I18n.available_locales.each do |loc| %>
                  <% active = (loc == I18n.locale) %>
                  <%= link_to loc.to_s.upcase, path_for_locale(loc), lang: loc, hreflang: loc,
                        "aria-current": (active ? "true" : nil),
                        class: "rounded-lg px-2.5 py-1.5 text-xs font-semibold transition #{active ? 'bg-brand-50 text-brand-700' : 'text-sand-500 hover:text-sand-900'}" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div id="flash" class="pointer-events-none fixed inset-x-4 top-24 z-[60] mx-auto flex max-w-sm flex-col gap-2 sm:inset-x-auto sm:right-6">
      <%= render "shared/toasts" %>
    </div>

    <main id="contenido" class="min-h-[70vh]">
      <%= yield %>
    </main>

    <%= render "shared/whatsapp" %>

    <footer class="mt-20 border-t border-sand-200 bg-sand-100">
      <%# El popup de entrada (shared/newsletter_popup) sigue apagado a propósito. %>
      <%= render "shared/newsletter_footer" %>
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 sm:grid-cols-2 sm:px-8 lg:grid-cols-4">
        <div class="max-w-sm lg:col-span-2">
          <%= image_tag "encar-stays-logo-green.png", alt: t("site.name"), width: 175, height: 200, class: "h-16 w-auto" %>
          <p class="mt-4 text-base leading-relaxed text-sand-600"><%= t("layout.footer_blurb") %></p>
          <p class="mt-4 flex items-center gap-1.5 text-base text-sand-600"><%= icon :pin, klass: "h-4 w-4 text-sand-500" %> <%= t("layout.footer_location") %></p>
        </div>

        <div>
          <h3 class="kicker text-sand-900"><%= t("layout.footer_explore") %></h3>
          <ul class="mt-4 space-y-2.5 text-base">
            <li><%= link_to t("layout.nav_properties"), properties_path, class: "text-sand-600 transition-colors hover:text-sand-900 hover:underline" %></li>
            <li><%= link_to t("layout.nav_attractions"), attractions_path, class: "text-sand-600 transition-colors hover:text-sand-900 hover:underline" %></li>
            <li><%= link_to t("layout.nav_events"), events_path, class: "text-sand-600 transition-colors hover:text-sand-900 hover:underline" %></li>
            <li><%= link_to t("layout.nav_blog"), posts_path, class: "text-sand-600 transition-colors hover:text-sand-900 hover:underline" %></li>
            <li><%= link_to t("layout.footer_lookup"), booking_lookup_path, class: "text-sand-600 transition-colors hover:text-sand-900 hover:underline" %></li>
          </ul>
        </div>

        <div>
          <h3 class="kicker text-sand-900"><%= t("layout.footer_contact") %></h3>
          <ul class="mt-4 space-y-2.5 text-base">
            <li>
              <%= link_to whatsapp_url(t("whatsapp.default_message")), target: "_blank", rel: "noopener",
                    class: "inline-flex items-center gap-2 text-sand-600 transition-colors hover:text-sand-900" do %>
                <span class="inline-block h-2 w-2 rounded-full bg-[#25D366]"></span> WhatsApp
              <% end %>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-sand-200">
        <div class="mx-auto max-w-7xl px-5 py-5 text-base text-sand-500 sm:px-8">
          <p><%= t("layout.footer_rights", year: Date.current.year) %></p>
        </div>
      </div>
    </footer>
  </body>
</html>
