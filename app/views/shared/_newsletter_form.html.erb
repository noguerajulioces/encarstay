<%# Signup form shared by the footer band and the popup. The wrapper id is the
    Turbo Stream replace target, unique per surface so both forms self-swap
    independently on the same page. Locals: variant ("footer"/"popup"), error. %>
<div id="newsletter_<%= variant %>">
  <% if local_assigns[:error] %>
    <p class="mb-2 text-sm text-rose-700"><%= t("newsletter.invalid_email") %></p>
  <% end %>

  <%= form_with url: subscription_path, scope: :subscriber, class: "flex flex-col gap-2 sm:flex-row" do |form| %>
    <%= hidden_field_tag :variant, variant %>

    <%# Honeypot — hidden from humans, tempting to bots. %>
    <div class="hidden" aria-hidden="true">
      <label><%= t("newsletter.honeypot") %><%= text_field_tag :company, nil, tabindex: -1, autocomplete: "off" %></label>
    </div>

    <%= form.email_field :email, required: true, placeholder: t("newsletter.email_placeholder"),
          "aria-label": t("newsletter.email_label"),
          class: "w-full rounded-xl border border-sand-200 bg-white px-4 py-2.5 text-sm text-sand-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-500 sm:flex-1" %>

    <%= form.button type: :submit,
          class: "flex items-center justify-center gap-2 whitespace-nowrap rounded-xl bg-brand-500 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-brand-600 cursor-pointer" do %>
      <%= t("newsletter.submit") %> <%= icon :arrow, klass: "h-4 w-4" %>
    <% end %>
  <% end %>

  <p class="mt-2 text-xs text-sand-500"><%= t("newsletter.privacy_note") %></p>
</div>
