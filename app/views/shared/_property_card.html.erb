<% photos = property.photos.select { |photo| photo.image.attached? }.first(5) %>
<% image_loading = local_assigns.fetch(:image_loading, "lazy") %>
<div class="group relative flex flex-col">
  <div class="relative aspect-square overflow-hidden rounded-2xl bg-sand-100">
    <% if property.property_type.present? %>
      <span class="absolute left-3 top-3 z-20 rounded-lg bg-white/95 px-2.5 py-1 text-xs font-semibold text-sand-800 shadow-sm">
        <%= t("property_types.#{property.property_type}") %>
      </span>
    <% end %>
    <% if photos.size > 1 %>
      <div data-controller="card-carousel" class="h-full">
        <div data-card-carousel-target="track"
             class="flex h-full snap-x snap-mandatory overflow-x-auto scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          <% photos.each_with_index do |photo, index| %>
            <% card_url = url_for(photo.image.variant(:card)) %>
            <% if index.zero? %>
              <%= image_tag card_url, alt: property.name, loading: image_loading,
                    fetchpriority: (image_loading == "eager" ? "high" : "auto"),
                    data: { card_carousel_target: "image" },
                    class: "h-full w-full shrink-0 snap-center object-cover" %>
            <% else %>
              <%= tag.img alt: property.name, loading: "lazy",
                    data: { card_carousel_target: "image", card_carousel_src_value: card_url },
                    class: "h-full w-full shrink-0 snap-center object-cover" %>
            <% end %>
          <% end %>
        </div>

        <button type="button" data-card-carousel-target="prev" data-action="card-carousel#go" data-card-carousel-dir-param="-1"
                aria-label="‹" class="absolute left-2 top-1/2 z-30 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-full bg-white/95 text-sand-900 opacity-0 shadow transition group-hover:opacity-100 hover:scale-105">
          <%= icon :chevron_left, klass: "h-4 w-4" %>
        </button>
        <button type="button" data-card-carousel-target="next" data-action="card-carousel#go" data-card-carousel-dir-param="1"
                aria-label="›" class="absolute right-2 top-1/2 z-30 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-full bg-white/95 text-sand-900 opacity-0 shadow transition group-hover:opacity-100 hover:scale-105">
          <%= icon :chevron_right, klass: "h-4 w-4" %>
        </button>

        <div class="pointer-events-none absolute inset-x-0 bottom-2 z-20 flex justify-center gap-1.5">
          <% photos.each_with_index do |_, i| %>
            <span data-card-carousel-target="dot" class="h-1.5 w-1.5 rounded-full bg-white shadow <%= i.zero? ? 'opacity-100' : 'opacity-50' %>"></span>
          <% end %>
        </div>
      </div>
    <% elsif photos.size == 1 %>
      <% card_url = url_for(photos.first.image.variant(:card)) %>
      <%= image_tag card_url, alt: property.name, loading: image_loading,
            fetchpriority: (image_loading == "eager" ? "high" : "auto"),
            class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-sand-100 to-sand-200 font-display text-5xl font-semibold text-sand-400">
        <%= property.name.first %>
      </div>
    <% end %>
  </div>

  <button type="button"
          data-controller="favorite"
          data-favorite-slug-value="<%= property.slug %>"
          data-action="favorite#toggle"
          aria-pressed="false"
          aria-label="<%= t("property.save") %>"
          class="absolute right-2 top-2 z-20 grid h-11 w-11 place-items-center rounded-full text-white transition hover:scale-110 aria-pressed:text-rose-500 [&[aria-pressed=true]_svg]:fill-rose-500 [&_svg]:drop-shadow-[0_1px_2px_rgba(0,0,0,0.45)]">
    <%= icon :heart, klass: "h-6 w-6" %>
  </button>

  <div class="mt-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="min-w-0 truncate font-sans text-lg font-semibold text-sand-900">
        <%= link_to property.name,
              property_path(property, check_in: local_assigns[:check_in], check_out: local_assigns[:check_out]),
              class: "transition-colors after:absolute after:inset-0 after:z-10 group-hover:text-brand-700" %>
      </h3>
      <% if property.rated? %>
        <span class="flex shrink-0 items-center gap-1 text-base text-sand-900">
          <%= icon :star, klass: "h-4 w-4", filled: true %><%= rating_display(property) %>
        </span>
      <% else %>
        <span class="shrink-0 text-base text-sand-500"><%= t("property.new_listing") %></span>
      <% end %>
    </div>

    <% if property.address_area.present? %>
      <p class="mt-0.5 truncate text-base text-sand-500"><%= property.address_area %></p>
    <% end %>
    <p class="mt-0.5 text-base text-sand-500"><%= guests_label(property.capacity) %></p>

    <p class="mt-3 text-base">
      <span class="font-display text-lg font-semibold text-sand-900"><%= money(property.base_price_cents, property.currency) %></span>
      <span class="text-sand-600"><%= t("units.per_night") %></span>
    </p>
  </div>
</div>
