<%= link_to property_path(property, check_in: local_assigns[:check_in], check_out: local_assigns[:check_out]),
      class: "group block rounded-2xl overflow-hidden bg-white border border-stone-200 hover:shadow-lg transition-shadow" do %>
  <div class="aspect-[4/3] overflow-hidden">
    <% if property.cover_photo %>
      <%= image_tag property.cover_photo.image.variant(resize_to_fill: [ 640, 480 ]),
            alt: "#{property.name} en #{property.address_area}", loading: "lazy",
            class: "h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" %>
    <% else %>
      <div class="h-full w-full bg-gradient-to-br from-emerald-600 to-emerald-900 flex items-center justify-center text-white text-4xl font-semibold">
        <%= property.name.first %>
      </div>
    <% end %>
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2">
      <div>
        <h3 class="font-semibold text-stone-900"><%= property.name %></h3>
        <p class="text-sm text-stone-500"><%= property.address_area %></p>
      </div>
      <span class="shrink-0 text-xs bg-stone-100 text-stone-600 rounded-full px-2 py-1">
        <%= property.capacity %> huéspedes
      </span>
    </div>
    <p class="mt-3 text-sm text-stone-600">
      <span class="font-semibold text-stone-900"><%= money(property.base_price_cents, property.currency) %></span>
      <span class="text-stone-500">/ noche</span>
    </p>
  </div>
<% end %>
