<%= link_to property_path(property, check_in: local_assigns[:check_in], check_out: local_assigns[:check_out]),
      class: "group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-[0_2px_10px_-6px_rgba(94,72,50,0.25)] transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_24px_44px_-24px_rgba(94,72,50,0.55)]" do %>
  <div class="relative aspect-[4/3] overflow-hidden">
    <% if property.cover_photo %>
      <%= image_tag property.cover_photo.image.variant(resize_to_fill: [ 640, 480 ]),
            alt: property.name, loading: "lazy",
            class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]" %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-500 to-brand-800 font-display text-5xl font-semibold text-brand-50">
        <%= property.name.first %>
      </div>
    <% end %>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/25 to-transparent"></div>

    <% if property.address_area.present? %>
      <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-brand-800 shadow-sm backdrop-blur">
        <%= icon :pin, klass: "h-3.5 w-3.5" %><%= property.address_area %>
      </span>
    <% end %>
    <span class="absolute right-3 top-3 grid h-8 w-8 place-items-center rounded-full bg-white/85 text-brand-600 shadow-sm backdrop-blur transition-colors group-hover:text-brand-800" aria-hidden="true">
      <%= icon :heart, klass: "h-4 w-4" %>
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-lg font-semibold leading-snug text-brand-900 transition-colors group-hover:text-brand-700"><%= property.name %></h3>
    <p class="mt-1 flex items-center gap-1 text-sm text-sand-500">
      <%= icon :users, klass: "h-4 w-4 text-sand-400" %><%= guests_label(property.capacity) %>
      <span class="text-sand-300">·</span>
      <%= property.bedrooms %> <%= t("property.bedrooms") %>
    </p>

    <div class="mt-4 flex items-end justify-between border-t border-sand-100 pt-4">
      <p class="text-sm text-sand-500">
        <span class="text-xs uppercase tracking-wide text-sand-400"><%= t("units.from") %></span><br>
        <span class="font-display text-xl font-semibold text-brand-900"><%= money(property.base_price_cents, property.currency) %></span>
        <span class="text-sand-500"><%= t("units.per_night") %></span>
      </p>
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-700 transition-transform group-hover:translate-x-0.5">
        <%= t("property.view") %> <%= icon :arrow, klass: "h-4 w-4" %>
      </span>
    </div>
  </div>
<% end %>
