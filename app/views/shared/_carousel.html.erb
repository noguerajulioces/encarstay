<%# A horizontal, snap-scrolling row (Airbnb-style). Render via `render layout:`
    with a block of cards. Locals: title, subtitle (optional),
    see_all (optional hash with :label and :path). %>
<section class="mx-auto max-w-7xl px-5 sm:px-8" data-controller="carousel">
  <div class="flex items-end justify-between gap-3">
    <div>
      <h2 class="font-display text-2xl font-semibold text-sand-900"><%= title %></h2>
      <% if local_assigns[:subtitle].present? %>
        <p class="mt-1 text-sm text-sand-500"><%= subtitle %></p>
      <% end %>
    </div>
    <div class="flex items-center gap-3">
      <% if local_assigns[:see_all].present? %>
        <%= link_to see_all[:label], see_all[:path], class: "hidden text-sm font-semibold text-sand-900 underline underline-offset-2 hover:text-brand-700 sm:inline-block" %>
      <% end %>
      <div class="hidden items-center gap-2 md:flex">
        <button type="button" data-carousel-target="prev" data-action="carousel#prev" aria-label="‹"
                class="grid h-8 w-8 place-items-center rounded-full border border-sand-300 text-sand-700 transition hover:border-sand-900 hover:shadow-sm">
          <%= icon :chevron_left, klass: "h-4 w-4" %>
        </button>
        <button type="button" data-carousel-target="next" data-action="carousel#next" aria-label="›"
                class="grid h-8 w-8 place-items-center rounded-full border border-sand-300 text-sand-700 transition hover:border-sand-900 hover:shadow-sm">
          <%= icon :chevron_right, klass: "h-4 w-4" %>
        </button>
      </div>
    </div>
  </div>

  <div data-carousel-target="track"
       class="mt-5 flex snap-x gap-5 overflow-x-auto scroll-smooth pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <%= yield %>
  </div>
</section>
