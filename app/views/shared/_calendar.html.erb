<%# locals: property, occupied, months (default 2), selectable (default false) %>
<% months ||= 2 %>
<% selectable = false unless defined?(selectable) %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 <%= "select-none touch-manipulation" if selectable %>">
  <% months.times do |offset| %>
    <% month = Date.current.beginning_of_month + offset.months %>
    <div>
      <p class="font-medium text-sand-900 text-center capitalize mb-2"><%= l month, format: :month_year %></p>
      <div class="grid grid-cols-7 text-center text-xs text-sand-400 mb-1">
        <% t("calendar.weekday_initials").each { |day| %><span><%= day %></span><% } %>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-sm">
        <% calendar_month_days(month).each do |day| %>
          <% if day.month != month.month %>
            <span></span>
          <% elsif day < Date.current %>
            <span class="py-1.5 text-sand-300"><%= day.day %></span>
          <% elsif occupied.include?(day) %>
            <span class="py-1.5 rounded bg-sand-100 text-sand-400 line-through"><%= day.day %></span>
          <% elsif selectable %>
            <button type="button"
                    data-date="<%= day.iso8601 %>"
                    data-date-range-target="day"
                    data-action="pointerdown->date-range#down pointerenter->date-range#enter"
                    class="py-1.5 rounded cursor-pointer transition-colors bg-brand-50 text-brand-800 hover:bg-brand-100"><%= day.day %></button>
          <% else %>
            <span class="py-1.5 rounded bg-brand-50 text-brand-800"><%= day.day %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
<div class="flex flex-wrap gap-4 mt-4 text-xs text-sand-500">
  <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-brand-50 border border-brand-200"></span> <%= t("calendar.available") %></span>
  <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-sand-100 border border-sand-200"></span> <%= t("calendar.occupied") %></span>
  <% if selectable %>
    <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded bg-brand-700"></span> <%= t("calendar.your_stay") %></span>
  <% end %>
</div>
