<%# locals: quote %>
<div class="space-y-2 text-sm">
  <div class="flex justify-between text-sand-600">
    <span><%= t("price.lodging") %> · <%= nights_label(quote.nights) %></span>
    <span><%= money(quote.subtotal_cents, quote.currency) %></span>
  </div>
  <div class="flex justify-between text-sand-600">
    <span><%= t("price.cleaning") %></span>
    <span><%= money(quote.cleaning_fee_cents, quote.currency) %></span>
  </div>
  <div class="flex justify-between font-semibold text-sand-900 border-t border-sand-200 pt-2">
    <span><%= t("price.total") %></span>
    <span><%= money(quote.total_cents, quote.currency) %></span>
  </div>
  <div class="flex justify-between text-brand-800">
    <span><%= t("price.deposit") %></span>
    <span><%= money(quote.deposit_cents, quote.currency) %></span>
  </div>
</div>
