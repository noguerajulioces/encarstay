<%= form_with model: search, url: search_path, method: :get,
      class: "flex flex-col gap-2 md:flex-row md:items-stretch md:gap-0 md:rounded-2xl md:border md:border-sand-200 md:bg-white md:p-2 md:shadow-[0_18px_40px_-24px_rgba(94,72,50,0.5)]" do |form| %>
  <div class="flex flex-1 items-center gap-3 rounded-xl border border-sand-200 bg-white px-4 py-2.5 md:border-0 md:py-1">
    <span class="text-brand-500"><%= icon :calendar, klass: "h-5 w-5" %></span>
    <div class="min-w-0 flex-1">
      <%= form.label :check_in, t("search_form.check_in"), class: "block text-[0.65rem] font-semibold uppercase tracking-wider text-sand-400" %>
      <%= form.date_field :check_in, min: Date.current, class: "w-full bg-transparent text-sm font-medium text-sand-800 focus:outline-none" %>
    </div>
  </div>

  <div class="my-2 hidden w-px bg-sand-200 md:block"></div>

  <div class="flex flex-1 items-center gap-3 rounded-xl border border-sand-200 bg-white px-4 py-2.5 md:border-0 md:py-1">
    <span class="text-brand-500"><%= icon :calendar, klass: "h-5 w-5" %></span>
    <div class="min-w-0 flex-1">
      <%= form.label :check_out, t("search_form.check_out"), class: "block text-[0.65rem] font-semibold uppercase tracking-wider text-sand-400" %>
      <%= form.date_field :check_out, min: Date.current + 1, class: "w-full bg-transparent text-sm font-medium text-sand-800 focus:outline-none" %>
    </div>
  </div>

  <div class="my-2 hidden w-px bg-sand-200 md:block"></div>

  <div class="flex flex-1 items-center gap-3 rounded-xl border border-sand-200 bg-white px-4 py-2.5 md:border-0 md:py-1">
    <span class="text-brand-500"><%= icon :users, klass: "h-5 w-5" %></span>
    <div class="min-w-0 flex-1">
      <%= form.label :guests, t("search_form.guests"), class: "block text-[0.65rem] font-semibold uppercase tracking-wider text-sand-400" %>
      <%= form.number_field :guests, min: 1, placeholder: "2", class: "w-full bg-transparent text-sm font-medium text-sand-800 placeholder:text-sand-300 focus:outline-none" %>
    </div>
  </div>

  <%= form.button type: :submit,
        class: "group flex items-center justify-center gap-2 rounded-xl bg-brand-700 px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-brand-800 cursor-pointer md:ml-1" do %>
    <%= icon :search, klass: "h-5 w-5" %>
    <span><%= t("search_form.submit") %></span>
  <% end %>
<% end %>
