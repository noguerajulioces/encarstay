<%= form_with model: search, url: search_path, method: :get,
      data: {
        controller: "search-range",
        search_range_locale_value: I18n.locale,
        search_range_min_nights_value: Property.active.minimum(:min_nights) || 1,
        search_range_labels_value: {
          placeholder: t("search_form.dates_placeholder"),
          weekdays: t("search_form.weekdays")
        }.to_json
      },
      class: "relative flex flex-col gap-2 md:flex-row md:items-center md:gap-0 md:rounded-full md:border md:border-sand-200 md:bg-white md:p-2 md:pl-3 md:shadow-[0_18px_40px_-24px_rgba(0,0,0,0.5)]" do |form| %>
  <div class="flex flex-[1.5] cursor-pointer items-center gap-3 rounded-xl border border-sand-200 bg-white px-4 py-2.5 md:border-0 md:py-1"
       data-action="click->search-range#open">
    <span class="text-sand-700"><%= icon :calendar, klass: "h-5 w-5" %></span>
    <div class="min-w-0 flex-1">
      <span class="kicker block text-sand-500"><%= t("search_form.dates") %></span>
      <span data-search-range-target="display" class="block truncate text-sm font-medium text-sand-800"><%= t("search_form.dates_placeholder") %></span>
    </div>
    <button type="button" data-search-range-target="clear" data-action="click->search-range#clear" hidden
            class="rounded-full p-1 text-sand-400 hover:bg-sand-100 hover:text-sand-600" aria-label="<%= t("search_form.clear") %>">
      <%= icon :x, klass: "h-4 w-4" %>
    </button>
  </div>

  <%= form.hidden_field :check_in, data: { search_range_target: "checkIn" } %>
  <%= form.hidden_field :check_out, data: { search_range_target: "checkOut" } %>

  <div class="my-2 hidden w-px bg-sand-200 md:block"></div>

  <div class="flex flex-1 items-center gap-3 rounded-xl border border-sand-200 bg-white px-4 py-2.5 md:border-0 md:py-1">
    <span class="text-sand-700"><%= icon :users, klass: "h-5 w-5" %></span>
    <div class="min-w-0 flex-1">
      <%= form.label :guests, t("search_form.guests"), class: "kicker block text-sand-500" %>
      <%= form.number_field :guests, min: 1, placeholder: "2", class: "w-full bg-transparent text-sm font-medium text-sand-800 placeholder:text-sand-300 focus:outline-none" %>
    </div>
  </div>

  <%= form.button type: :submit,
        class: "group flex items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-brand-600 cursor-pointer md:ml-1 md:h-12 md:w-12 md:rounded-full md:px-0 md:py-0" do %>
    <%= icon :search, klass: "h-5 w-5" %>
    <span class="md:hidden"><%= t("search_form.submit") %></span>
  <% end %>

  <div data-search-range-target="panel" hidden
       class="absolute left-0 top-full z-20 mt-2 w-full max-w-sm rounded-2xl border border-sand-200 bg-white p-4 shadow-[0_18px_40px_-16px_rgba(0,0,0,0.45)]">
    <div data-search-range-target="calendar"></div>
  </div>
<% end %>
