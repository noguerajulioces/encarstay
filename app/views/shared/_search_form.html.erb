<%= form_with model: search, url: search_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-4 gap-3 items-end" do |form| %>
  <div>
    <%= form.label :check_in, t("search_form.check_in"), class: "block text-xs font-medium text-stone-500 mb-1" %>
    <%= form.date_field :check_in, min: Date.current, class: "w-full rounded-lg border-stone-300 border px-3 py-2 focus:border-emerald-600 focus:ring-emerald-600" %>
  </div>
  <div>
    <%= form.label :check_out, t("search_form.check_out"), class: "block text-xs font-medium text-stone-500 mb-1" %>
    <%= form.date_field :check_out, min: Date.current + 1, class: "w-full rounded-lg border-stone-300 border px-3 py-2 focus:border-emerald-600 focus:ring-emerald-600" %>
  </div>
  <div>
    <%= form.label :guests, t("search_form.guests"), class: "block text-xs font-medium text-stone-500 mb-1" %>
    <%= form.number_field :guests, min: 1, class: "w-full rounded-lg border-stone-300 border px-3 py-2 focus:border-emerald-600 focus:ring-emerald-600" %>
  </div>
  <%= form.submit t("search_form.submit"), class: "rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-4 py-2.5 cursor-pointer" %>
<% end %>
