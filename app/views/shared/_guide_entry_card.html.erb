<%# locals: entry %>
<%= link_to guide_entry_path(entry),
      class: "group flex flex-col overflow-hidden rounded-2xl border border-sand-200 bg-white shadow-[0_2px_10px_-6px_rgba(94,72,50,0.25)] transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_24px_44px_-24px_rgba(94,72,50,0.55)]" do %>
  <div class="relative aspect-[4/3] overflow-hidden">
    <% if entry.cover_image.attached? %>
      <%= image_tag entry.cover_image.variant(resize_to_fill: [ 640, 480 ]),
            alt: entry.title, loading: "lazy",
            class: "h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.06]" %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-400 to-brand-800 text-brand-50/90">
        <%= icon(entry.event? ? :ticket : :compass, klass: "h-12 w-12") %>
      </div>
    <% end %>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/25 to-transparent"></div>

    <% if entry.category.present? %>
      <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-brand-800 shadow-sm backdrop-blur">
        <%= icon(entry.category.icon.presence&.to_sym || :sparkles, klass: "h-3.5 w-3.5") %><%= entry.category.name %>
      </span>
    <% end %>
    <% if entry.event? %>
      <div class="absolute right-3 top-3"><%= render "shared/event_date_badge", entry: entry %></div>
    <% end %>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-lg font-semibold leading-snug text-brand-900 transition-colors group-hover:text-brand-700"><%= entry.title %></h3>
    <% if entry.summary.present? %>
      <p class="mt-1 line-clamp-2 text-sm text-sand-500"><%= entry.summary %></p>
    <% end %>
    <div class="mt-4 flex items-center justify-between border-t border-sand-100 pt-3 text-sm">
      <span class="flex items-center gap-1 text-sand-500">
        <% if entry.event? && entry.schedule_note.present? %>
          <%= icon :calendar, klass: "h-4 w-4 text-brand-400" %><%= entry.schedule_note %>
        <% elsif entry.area.present? %>
          <%= icon :pin, klass: "h-4 w-4 text-brand-400" %><%= entry.area %>
        <% end %>
      </span>
      <span class="inline-flex items-center gap-1 font-semibold text-brand-700 transition-transform group-hover:translate-x-0.5">
        <%= t("guide.read_more") %> <%= icon :arrow, klass: "h-4 w-4" %>
      </span>
    </div>
  </div>
<% end %>
