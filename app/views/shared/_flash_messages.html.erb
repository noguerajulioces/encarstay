<% if notice.present? %>
  <div class="rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm" role="status"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="rounded-lg bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm" role="alert"><%= alert %></div>
<% end %>
