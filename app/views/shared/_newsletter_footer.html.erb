<%# Full-width newsletter band at the top of the footer. %>
<div class="border-b border-sand-200">
  <div class="mx-auto grid max-w-7xl items-center gap-6 px-5 py-10 sm:px-8 lg:grid-cols-2">
    <div>
      <h3 class="font-display text-xl font-semibold text-sand-900"><%= t("newsletter.footer_heading") %></h3>
      <p class="mt-1.5 text-sm text-sand-600"><%= t("newsletter.footer_blurb") %></p>
    </div>
    <div class="lg:w-full lg:max-w-md lg:justify-self-end">
      <%= render "shared/newsletter_form", variant: "footer" %>
    </div>
  </div>
</div>
