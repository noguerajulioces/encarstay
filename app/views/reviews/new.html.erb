<% content_for :title, t("review.title", property: @booking.property.name) %>

<section class="mx-auto max-w-xl px-5 py-12">
  <% if @booking.review&.persisted? %>
    <div class="text-center">
      <p class="text-4xl">🎉</p>
      <h1 class="mt-3 font-display text-2xl font-semibold text-sand-900"><%= t("review.thanks_heading") %></h1>
      <p class="mt-2 text-sand-600"><%= t("review.thanks_body") %></p>
      <%= link_to t("review.back_home"), root_path,
            class: "mt-6 inline-flex items-center gap-2 rounded-xl border border-sand-200 px-6 py-3 font-semibold text-sand-800 transition-colors hover:bg-sand-100" %>
    </div>
  <% else %>
    <p class="text-xs font-semibold uppercase tracking-widest text-sand-700"><%= t("review.kicker") %></p>
    <h1 class="mt-1 font-display text-3xl font-semibold text-sand-900"><%= t("review.heading", property: @booking.property.name) %></h1>
    <p class="mt-2 text-sand-500"><%= t("review.subtitle", dates: "#{l @booking.check_in, format: :long} – #{l @booking.check_out, format: :long}") %></p>

    <%= form_with model: @review, url: review_path(params[:token]), class: "mt-8 space-y-5" do |form| %>
      <% if @review.errors.any? %>
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <ul class="list-inside list-disc">
            <% @review.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="rounded-2xl border border-sand-200 bg-white p-5">
        <p class="mb-2 block text-sm font-medium text-sand-700"><%= t("review.rating_label") %></p>
        <fieldset data-controller="rating" data-action="mouseleave->rating#leave" class="flex gap-1">
          <legend class="sr-only"><%= t("review.rating_label") %></legend>
          <% (1..5).each do |value| %>
            <label class="cursor-pointer" title="<%= t("review.stars", count: value) %>">
              <%= form.radio_button :rating, value, class: "sr-only",
                    data: { action: "change->rating#select" } %>
              <span data-rating-target="star" data-action="mouseenter->rating#hover" data-rating-value-param="<%= value %>" class="block text-sand-300 transition-colors">
                <%= star_icon(klass: "h-9 w-9") %>
              </span>
              <span class="sr-only"><%= t("review.stars", count: value) %></span>
            </label>
          <% end %>
        </fieldset>
      </div>

      <% field = "w-full rounded-xl border border-sand-200 px-3 py-2.5 text-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500" %>
      <div class="space-y-4 rounded-2xl border border-sand-200 bg-white p-5">
        <div>
          <%= form.label :reviewer_location, t("review.location_label"), class: "mb-1 block text-sm font-medium text-sand-700" %>
          <%= form.text_field :reviewer_location, placeholder: t("review.location_placeholder"), class: field %>
        </div>
        <div>
          <%= form.label :body, t("review.body_label"), class: "mb-1 block text-sm font-medium text-sand-700" %>
          <%= form.text_area :body, rows: 4, class: field %>
        </div>
      </div>

      <%= form.button type: :submit, class: "flex w-full items-center justify-center gap-2 rounded-xl bg-brand-500 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-600 cursor-pointer sm:w-auto" do %>
        <%= t("review.submit") %> <%= icon :arrow, klass: "h-4 w-4" %>
      <% end %>
    <% end %>
  <% end %>
</section>
