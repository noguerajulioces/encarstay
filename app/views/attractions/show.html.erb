<% content_for :title, @attraction.title %>
<% content_for :description, (@attraction.summary.presence || @attraction.title).to_s.truncate(150) %>
<% content_for :og_type, "article" %>
<% content_for(:og_image, rails_blob_url(@attraction.cover_image)) if @attraction.cover_image.attached? %>
<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "TouristAttraction",
    "name" => @attraction.title,
    "description" => (strip_tags(@attraction.description.to_s).squish.presence || @attraction.summary),
    "image" => (@attraction.cover_image.attached? ? rails_blob_url(@attraction.cover_image) : nil),
    "url" => attraction_url(@attraction),
    "address" => { "@type" => "PostalAddress", "streetAddress" => @attraction.address.presence, "addressLocality" => "Encarnación", "addressCountry" => "PY" }.compact,
    "geo" => (@attraction.latitude.present? && @attraction.longitude.present? ? { "@type" => "GeoCoordinates", "latitude" => @attraction.latitude.to_f, "longitude" => @attraction.longitude.to_f } : nil)
  }.compact) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => t("guide.attractions_title"), "item" => attractions_url },
      { "@type" => "ListItem", "position" => 2, "name" => @attraction.title, "item" => attraction_url(@attraction) }
    ]
  }) %>
<% end %>

<div class="mx-auto max-w-6xl px-5 pt-6">
  <nav class="mb-4 flex items-center gap-1.5 text-sm text-sand-500">
    <%= link_to t("guide.attractions_title"), attractions_path, class: "hover:text-brand-700" %>
    <span class="text-sand-300">/</span>
    <span class="truncate text-sand-700"><%= @attraction.title %></span>
  </nav>

  <div class="relative aspect-[16/10] overflow-hidden rounded-3xl sm:aspect-[16/7]">
    <% if @attraction.cover_image.attached? %>
      <%= image_tag @attraction.cover_image.variant(resize_to_fill: [ 1600, 700 ]), alt: @attraction.title, class: "h-full w-full object-cover" %>
    <% else %>
      <div class="h-full w-full bg-gradient-to-br from-brand-500 to-brand-900"></div>
    <% end %>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10">
      <div class="flex flex-wrap items-center gap-2">
        <% if @attraction.category.present? %>
          <span class="inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-sand-900">
            <%= icon(@attraction.category.icon.presence&.to_sym || :compass, klass: "h-3.5 w-3.5") %><%= @attraction.category.name %>
          </span>
        <% end %>
        <% if @attraction.area.present? %>
          <span class="inline-flex items-center gap-1 rounded-full bg-brand-500/90 px-2.5 py-1 text-xs font-semibold text-white">
            <%= icon :pin, klass: "h-3.5 w-3.5" %><%= @attraction.area %>
          </span>
        <% end %>
      </div>
      <h1 class="mt-3 max-w-3xl font-display text-3xl font-semibold text-white sm:text-5xl"><%= @attraction.title %></h1>
    </div>
  </div>
</div>

<div class="mx-auto mt-8 grid max-w-6xl gap-10 px-5 pb-8 lg:grid-cols-3">
  <div class="space-y-8 lg:col-span-2">
    <% if @attraction.summary.present? %>
      <p class="text-xl leading-relaxed text-sand-900"><%= @attraction.summary %></p>
    <% end %>

    <% if @attraction.description.present? %>
      <div class="max-w-none whitespace-pre-line text-lg leading-relaxed text-sand-700"><%= @attraction.description %></div>
    <% end %>

    <% if @attraction.external_url.present? %>
      <%= link_to t("guide.official_link"), @attraction.external_url, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:underline" %>
    <% end %>

    <div>
      <h2 class="mb-3 font-display text-xl font-semibold text-sand-900"><%= t("guide.location") %></h2>
      <%= render "shared/map", title: @attraction.title, latitude: @attraction.latitude, longitude: @attraction.longitude, address: @attraction.address.presence || @attraction.area %>
    </div>
  </div>

  <aside class="lg:col-span-1">
    <%= render "shared/guide_sidebar", entry: @attraction, properties: @properties %>
  </aside>
</div>

<% if @related.any? %>
  <section class="mx-auto max-w-6xl px-5 pb-8">
    <h2 class="mb-6 font-display text-2xl font-semibold text-sand-900"><%= t("guide.more_places") %></h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @related.each do |attraction| %>
        <%= render "shared/guide_entry_card", entry: attraction %>
      <% end %>
    </div>
  </section>
<% end %>
