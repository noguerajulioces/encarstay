<% content_for :title, t("properties.index_title") %>

<section class="mx-auto max-w-7xl px-5 pt-10 pb-4 sm:pt-14">
  <p class="text-xs font-semibold uppercase tracking-widest text-sand-700"><%= t("properties.index_kicker") %></p>
  <h1 class="mt-1 font-display text-4xl font-semibold text-sand-900"><%= t("properties.index_title") %></h1>
  <p class="mt-2 max-w-xl text-sand-500"><%= t("properties.index_subtitle") %></p>
</section>

<section class="mx-auto max-w-7xl px-5 pb-4">
  <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <% @properties.each_with_index do |property, index| %>
      <%= render "shared/property_card", property: property, image_loading: (index.zero? ? "eager" : "lazy") %>
    <% end %>
  </div>
</section>
