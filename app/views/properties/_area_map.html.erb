<%# locals: (comparison:, costanera: nil)
    Mapa ilustrado de las propiedades: proyección lineal de lat/lng a un lienzo
    SVG, corrigiendo km-por-grado para que la escala sea uniforme en ambos ejes.
    No es cartografía — por eso la nota "ilustrativo" y los enlaces a Google Maps. %>
<% points = comparison.select { |entry| entry[:property].coordinates? } %>
<% if points.any? %>
  <%
    width, height, pad = 800.0, 520.0, 90.0
    lats = points.map { |entry| entry[:property].latitude.to_f }
    lngs = points.map { |entry| entry[:property].longitude.to_f }
    if costanera&.latitude.present?
      lats << costanera.latitude.to_f
      lngs << costanera.longitude.to_f
    end

    mid_lat_rad = (lats.min + lats.max) / 2 * Math::PI / 180
    km_per_lat = 111.32
    km_per_lng = 111.32 * Math.cos(mid_lat_rad)
    span_x_km = [ (lngs.max - lngs.min) * km_per_lng, 0.5 ].max
    span_y_km = [ (lats.max - lats.min) * km_per_lat, 0.5 ].max
    scale = [ (width - 2 * pad) / span_x_km, (height - 2 * pad) / span_y_km ].min
    offset_x = (width - span_x_km * scale) / 2
    offset_y = (height - span_y_km * scale) / 2

    project = ->(lat, lng) do
      [ (offset_x + (lng.to_f - lngs.min) * km_per_lng * scale).round(1),
        (offset_y + (lats.max - lat.to_f) * km_per_lat * scale).round(1) ]
    end

    scale_bar_km = scale * 1 > width * 0.4 ? 0.5 : 1.0
    scale_bar_px = (scale_bar_km * scale).round(1)
  %>

  <div class="overflow-hidden rounded-3xl border border-sand-200 bg-white">
    <svg viewBox="0 0 <%= width.to_i %> <%= height.to_i %>" role="img" aria-label="<%= t("compare.map_label") %>" class="block h-auto w-full bg-brand-50/60 font-sans">
      <%# Rosa de los vientos mínima: la proyección es norte-arriba %>
      <g class="stroke-sand-400" stroke-width="1.5" fill="none">
        <path stroke-linecap="round" d="M <%= width - 40 %> 58 V 34 m -6 8 6 -8 6 8"/>
      </g>
      <text x="<%= width - 40 %>" y="76" text-anchor="middle" class="fill-sand-500" font-size="14" font-weight="600">N</text>

      <%# Barra de escala %>
      <g class="stroke-sand-400" stroke-width="1.5">
        <path stroke-linecap="round" d="M 40 <%= height - 40 %> h <%= scale_bar_px %> m 0 -5 v 10 M 40 <%= height - 45 %> v 10"/>
      </g>
      <text x="<%= 40 + scale_bar_px / 2 %>" y="<%= height - 48 %>" text-anchor="middle" class="fill-sand-500" font-size="13">
        <%= scale_bar_km == 1.0 ? "1 km" : "500 m" %>
      </text>

      <% if costanera&.latitude.present? %>
        <% cx, cy = project.call(costanera.latitude, costanera.longitude) %>
        <% label_x = cx.clamp(120, width - 120) %>
        <g class="stroke-brand-300" stroke-width="3" fill="none" stroke-linecap="round">
          <path d="M <%= cx - 34 %> <%= cy %> q 8.5 -7 17 0 t 17 0"/>
          <path d="M <%= cx - 26 %> <%= cy + 12 %> q 6.5 -5.5 13 0 t 13 0" class="stroke-brand-200"/>
        </g>
        <text x="<%= label_x %>" y="<%= cy + 34 %>" text-anchor="middle" class="fill-brand-700" font-size="15" font-weight="600"><%= costanera.title %></text>
      <% end %>

      <% points.each_with_index do |entry, index| %>
        <% property = entry[:property] %>
        <% x, y = project.call(property.latitude, property.longitude) %>
        <a href="https://www.google.com/maps/search/?api=1&query=<%= property.latitude %>,<%= property.longitude %>" target="_blank" rel="noopener">
          <title><%= property.name %></title>
          <circle cx="<%= x %>" cy="<%= y %>" r="24" class="fill-brand-500/10"/>
          <circle cx="<%= x %>" cy="<%= y %>" r="15" class="fill-brand-500"/>
          <text x="<%= x %>" y="<%= y + 5.5 %>" text-anchor="middle" class="fill-white" font-size="15" font-weight="700"><%= index + 1 %></text>
        </a>
      <% end %>
    </svg>

    <p class="border-t border-sand-200 bg-white px-4 py-3 text-sm text-sand-500"><%= t("compare.map_note") %></p>
  </div>

  <ol class="mt-4 grid gap-2 sm:grid-cols-2">
    <% points.each_with_index do |entry, index| %>
      <% property = entry[:property] %>
      <li class="flex items-center gap-3 rounded-xl border border-sand-200 bg-white px-4 py-3">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-500 font-display text-base font-semibold text-white"><%= index + 1 %></span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-base font-semibold text-sand-900"><%= link_to property.name, property_path(property), class: "hover:text-brand-700" %></p>
          <% if property.distance_center_km.present? %>
            <p class="text-sm text-sand-500"><%= t("compare.distance_center", distance: distance_label(property.distance_center_km)) %></p>
          <% end %>
        </div>
        <%= link_to t("guide.open_in_maps"),
              "https://www.google.com/maps/search/?api=1&query=#{property.latitude},#{property.longitude}",
              target: "_blank", rel: "noopener", class: "shrink-0 text-sm font-semibold text-brand-700 hover:underline" %>
      </li>
    <% end %>
  </ol>
<% end %>
