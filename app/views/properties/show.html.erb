<% content_for :title, @property.name %>
<% content_for :description, @property.description.to_s.truncate(150) %>
<% content_for :og_type, "product" %>
<% content_for(:og_image, rails_blob_url(@property.cover_photo.image)) if @property.cover_photo %>
<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Product",
    "name" => @property.name,
    "description" => strip_tags(@property.description.to_s).squish.presence,
    "image" => (@property.cover_photo ? rails_blob_url(@property.cover_photo.image) : nil),
    "offers" => {
      "@type" => "Offer",
      "price" => (@property.base_price_cents / 100).to_s,
      "priceCurrency" => @property.currency,
      "availability" => "https://schema.org/InStock",
      "url" => property_url(@property)
    }
  }.compact) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => t("layout.nav_properties"), "item" => properties_url },
      { "@type" => "ListItem", "position" => 2, "name" => @property.name, "item" => property_url(@property) }
    ]
  }) %>
<% end %>

<nav class="text-sm text-stone-500 mb-4">
  <%= link_to t("layout.nav_properties"), properties_path, class: "hover:text-emerald-700" %> /
  <span class="text-stone-700"><%= @property.name %></span>
</nav>

<%# --- Gallery --- %>
<% if @property.photos.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 rounded-2xl overflow-hidden">
    <% @property.photos.each_with_index do |photo, index| %>
      <% next unless photo.image.attached? %>
      <div class="<%= index.zero? ? 'col-span-2 row-span-2 aspect-square' : 'aspect-square' %> overflow-hidden">
        <%= image_tag photo.image.variant(resize_to_fill: [ 800, 800 ]),
              alt: t("property.photo_alt", name: @property.name, index: index + 1), loading: (index.zero? ? "eager" : "lazy"),
              class: "h-full w-full object-cover" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="h-64 sm:h-80 rounded-2xl bg-gradient-to-br from-emerald-600 to-emerald-900 flex items-center justify-center text-white text-6xl font-semibold">
    <%= @property.name.first %>
  </div>
<% end %>

<div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8"
     data-controller="date-range"
     data-date-range-occupied-value="<%= @occupied_dates.map(&:iso8601).to_json %>"
     data-date-range-min-nights-value="<%= @property.min_nights %>"
     data-date-range-min-nights-overrides-value="<%= @min_nights_overrides.to_json %>"
     data-date-range-locale-value="<%= I18n.locale %>"
     data-date-range-labels-value="<%= {
       nightWord: t('calendar.night_word'),
       nightsWord: t('calendar.nights_word'),
       chooseExit: t('calendar.choose_exit'),
       chooseExitMin: t('calendar.choose_exit_min', count: '%{count}'),
       noFreeNights: t('calendar.no_free_nights', count: '%{count}')
     }.to_json %>">
  <%# --- Details --- %>
  <div class="lg:col-span-2">
    <h1 class="text-3xl font-bold text-stone-900"><%= @property.name %></h1>
    <p class="text-stone-500 mt-1"><%= @property.address_area %></p>

    <div class="flex flex-wrap gap-x-6 gap-y-2 mt-4 text-sm text-stone-600">
      <span><strong class="text-stone-900"><%= @property.capacity %></strong> <%= t("property.guests") %></span>
      <span><strong class="text-stone-900"><%= @property.bedrooms %></strong> <%= t("property.bedrooms") %></span>
      <span><strong class="text-stone-900"><%= @property.beds %></strong> <%= t("property.beds") %></span>
      <span><strong class="text-stone-900"><%= @property.bathrooms %></strong> <%= t("property.bathrooms") %></span>
      <span><%= t("property.min_stay") %> <strong class="text-stone-900"><%= @property.min_nights %></strong> <%= t("property.min_stay_nights") %></span>
    </div>

    <% if @property.description.present? %>
      <div class="prose prose-stone mt-6 max-w-none text-stone-700 whitespace-pre-line"><%= @property.description %></div>
    <% end %>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-stone-900 mb-3"><%= t("property.availability") %></h2>
      <p class="text-sm text-stone-500 mb-3"><%= t("property.calendar_help") %></p>
      <%= render "shared/calendar", property: @property, occupied: @occupied_dates, months: 2, selectable: true %>
      <div class="mt-3 flex items-center gap-3 text-sm" data-date-range-target="controls" hidden>
        <span class="font-medium text-stone-700" data-date-range-target="summary"></span>
        <button type="button" data-action="date-range#clear" class="text-stone-500 underline underline-offset-2 hover:text-stone-700 cursor-pointer"><%= t("property.clear") %></button>
      </div>
    </div>
  </div>

  <%# --- Booking box (sticky) --- %>
  <div class="lg:col-span-1">
    <div class="lg:sticky lg:top-24 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-stone-900">
        <span class="text-2xl font-bold"><%= money(@property.base_price_cents, @property.currency) %></span>
        <span class="text-stone-500 text-sm"><%= t("units.per_night") %></span>
      </p>

      <%= form_with url: property_path(@property), method: :get, data: { turbo_frame: "quote", turbo_action: "advance", date_range_target: "form" }, class: "mt-4 space-y-3" do |form| %>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= form.label :check_in, t("property.arrival"), class: "block text-xs font-medium text-stone-500 mb-1" %>
            <%= form.date_field :check_in, value: @check_in, min: Date.current, data: { date_range_target: "checkIn", action: "change->date-range#syncFromInputs" }, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
          </div>
          <div>
            <%= form.label :check_out, t("property.departure"), class: "block text-xs font-medium text-stone-500 mb-1" %>
            <%= form.date_field :check_out, value: @check_out, min: Date.current + 1, data: { date_range_target: "checkOut", action: "change->date-range#syncFromInputs" }, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
          </div>
        </div>
        <div>
          <%= form.label :guests, t("property.guests_label"), class: "block text-xs font-medium text-stone-500 mb-1" %>
          <%= form.number_field :guests, value: @guests, min: 1, max: @property.capacity, data: { action: "change->date-range#refresh" }, class: "w-full rounded-lg border-stone-300 border px-3 py-2" %>
        </div>
        <%= form.submit t("property.see_price"), data: { date_range_target: "submit" }, hidden: @quote.valid?, class: "w-full rounded-lg border border-emerald-700 text-emerald-800 font-medium px-4 py-2.5 hover:bg-emerald-50 cursor-pointer" %>
      <% end %>

      <%= turbo_frame_tag "quote" do %>
        <% if @quote.valid? %>
          <div class="mt-5 pt-5 border-t border-stone-200">
            <%= render "shared/price_breakdown", quote: @quote %>
            <% if @available %>
              <%= link_to t("property.book"), new_booking_path(property_slug: @property.slug, check_in: @check_in, check_out: @check_out, guests: @guests),
                    data: { turbo_frame: "_top" },
                    class: "mt-4 block text-center rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-4 py-3" %>
            <% else %>
              <p class="mt-4 rounded-lg bg-rose-50 text-rose-700 text-sm text-center px-4 py-3">
                <%= t("property.not_available") %>
              </p>
            <% end %>
          </div>
        <% else %>
          <p class="mt-5 pt-5 border-t border-stone-200 text-sm text-stone-500">
            <%= t("property.pick_dates") %>
          </p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
