<% content_for :title, @property.name %>
<% content_for :description, @property.description.to_s.truncate(150) %>
<% content_for :og_type, "product" %>
<% content_for(:og_image, rails_blob_url(@property.cover_photo.image)) if @property.cover_photo %>
<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Product",
    "name" => @property.name,
    "description" => strip_tags(@property.description.to_s).squish.presence,
    "image" => (@property.cover_photo ? rails_blob_url(@property.cover_photo.image) : nil),
    "offers" => {
      "@type" => "Offer",
      "price" => (@property.base_price_cents / 100).to_s,
      "priceCurrency" => @property.currency,
      "availability" => "https://schema.org/InStock",
      "url" => property_url(@property)
    }
  }.compact) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => t("layout.nav_properties"), "item" => properties_url },
      { "@type" => "ListItem", "position" => 2, "name" => @property.name, "item" => property_url(@property) }
    ]
  }) %>
<% end %>

<div class="mx-auto max-w-6xl px-5 pt-6">
  <nav class="mb-4 flex items-center gap-1.5 text-base text-sand-500">
    <%= link_to t("layout.nav_properties"), properties_path, class: "hover:text-brand-700" %>
    <span class="text-sand-300">/</span>
    <span class="text-sand-700"><%= @property.name %></span>
  </nav>

  <%# --- Gallery (Airbnb-style mosaic + full-screen viewer) --- %>
  <% photos = @property.photos.select { |photo| photo.image.attached? } %>
  <% if photos.any? %>
    <% mosaic = photos.first(5) %>
    <div data-controller="gallery"
         data-gallery-urls-value="<%= photos.map { |photo| url_for(photo.image.variant(:gallery)) }.to_json %>">

      <%# Mobile: a single tappable photo opens the viewer %>
      <button type="button" data-action="gallery#open" data-index="0"
              class="relative block w-full overflow-hidden rounded-2xl md:hidden">
        <%= image_tag mosaic.first.image.variant(:preview),
              alt: t("property.photo_alt", name: @property.name, index: 1), loading: "eager",
              class: "aspect-[4/3] w-full object-cover" %>
        <span class="absolute bottom-3 right-3 rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white"><%= "1 / #{photos.size}" %></span>
      </button>

      <%# Desktop: photo mosaic %>
      <div class="relative hidden md:block">
        <% if mosaic.size >= 5 %>
          <div class="grid aspect-[2/1] grid-cols-4 grid-rows-2 gap-2 overflow-hidden rounded-3xl">
            <% mosaic.each_with_index do |photo, index| %>
              <button type="button" data-action="gallery#open" data-index="<%= index %>"
                      class="group relative overflow-hidden <%= 'col-span-2 row-span-2' if index.zero? %>">
                <%= image_tag photo.image.variant(index.zero? ? :preview : :card),
                      alt: t("property.photo_alt", name: @property.name, index: index + 1), loading: (index.zero? ? "eager" : "lazy"),
                      class: "h-full w-full object-cover transition duration-300 group-hover:brightness-90" %>
              </button>
            <% end %>
          </div>
        <% else %>
          <div class="grid aspect-[2/1] grid-cols-2 gap-2 overflow-hidden rounded-3xl">
            <% mosaic.each_with_index do |photo, index| %>
              <button type="button" data-action="gallery#open" data-index="<%= index %>"
                      class="group relative overflow-hidden <%= 'col-span-2' if mosaic.size == 1 %>">
                <%= image_tag photo.image.variant(index.zero? ? :preview : :card),
                      alt: t("property.photo_alt", name: @property.name, index: index + 1), loading: (index.zero? ? "eager" : "lazy"),
                      class: "h-full w-full object-cover transition duration-300 group-hover:brightness-90" %>
              </button>
            <% end %>
          </div>
        <% end %>
        <button type="button" data-action="gallery#open" data-index="0"
                class="absolute bottom-4 right-4 inline-flex items-center gap-2 rounded-xl border border-sand-900/10 bg-white px-4 py-2 text-base font-semibold text-sand-900 shadow-sm transition hover:bg-sand-50">
          <%= icon :grid, klass: "h-4 w-4" %><%= t("property.show_all_photos") %>
        </button>
      </div>

      <%# Full-screen viewer %>
      <div data-gallery-target="lightbox" hidden class="fixed inset-0 z-50 flex flex-col bg-black">
        <div class="flex items-center justify-between px-4 py-3 text-white">
          <button type="button" data-action="gallery#close" aria-label="<%= t('property.close') %>"
                  class="rounded-full p-2 transition hover:bg-white/10"><%= icon :x, klass: "h-5 w-5" %></button>
          <span data-gallery-target="counter" class="text-base font-medium"></span>
          <span class="w-9"></span>
        </div>
        <div class="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden px-4 pb-6 sm:px-16"
             data-action="click->gallery#backdrop">
          <button type="button" data-action="gallery#prev" aria-label="<%= t('property.prev_photo') %>"
                  class="absolute left-3 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-2.5 text-white transition hover:bg-white/20 sm:left-6">
            <%= icon :chevron_left, klass: "h-6 w-6" %>
          </button>
          <img data-gallery-target="image" alt="<%= @property.name %>"
               class="max-h-full max-w-full rounded-lg object-contain">
          <button type="button" data-action="gallery#next" aria-label="<%= t('property.next_photo') %>"
                  class="absolute right-3 top-1/2 -translate-y-1/2 rounded-full bg-white/10 p-2.5 text-white transition hover:bg-white/20 sm:right-6">
            <%= icon :chevron_right, klass: "h-6 w-6" %>
          </button>
        </div>
      </div>
    </div>
  <% else %>
    <div class="flex h-64 items-center justify-center rounded-3xl bg-gradient-to-br from-sand-100 to-sand-200 font-display text-6xl font-semibold text-sand-400 sm:h-80">
      <%= @property.name.first %>
    </div>
  <% end %>
</div>

<div class="mx-auto mt-10 grid max-w-6xl grid-cols-1 gap-10 px-5 pb-6 lg:grid-cols-3"
     data-controller="date-range"
     data-date-range-occupied-value="<%= @occupied_dates.map(&:iso8601).to_json %>"
     data-date-range-min-nights-value="<%= @property.min_nights %>"
     data-date-range-min-nights-overrides-value="<%= @min_nights_overrides.to_json %>"
     data-date-range-locale-value="<%= I18n.locale %>"
     data-date-range-labels-value="<%= {
       nightWord: t('calendar.night_word'),
       nightsWord: t('calendar.nights_word'),
       chooseExit: t('calendar.choose_exit'),
       chooseExitMin: t('calendar.choose_exit_min', count: '%{count}'),
       noFreeNights: t('calendar.no_free_nights', count: '%{count}')
     }.to_json %>">
  <%# --- Details --- %>
  <div class="lg:col-span-2">
    <% if @property.property_type.present? %>
      <p class="kicker text-brand-700"><%= t("property_types.#{@property.property_type}") %></p>
    <% end %>
    <h1 class="mt-1 font-display text-4xl font-semibold leading-tight text-sand-900"><%= @property.name %></h1>
    <% if @property.rated? %>
      <p class="mt-2 flex flex-wrap items-center gap-1.5 text-base font-semibold text-sand-900">
        <%= icon :star, klass: "h-4 w-4", filled: true %><%= rating_display(@property) %>
        <span class="text-sand-300">·</span>
        <a href="#evaluaciones" class="font-medium underline decoration-sand-300 underline-offset-2 hover:decoration-brand-500"><%= t("property.reviews_count", count: @property.reviews_count) %></a>
        <% if @property.address_area.present? %>
          <span class="text-sand-300">·</span>
          <span class="font-medium text-sand-500"><%= @property.address_area %></span>
        <% end %>
      </p>
    <% elsif @property.address_area.present? %>
      <p class="mt-2 flex items-center gap-1.5 text-sand-500">
        <%= icon :pin, klass: "h-4 w-4 text-sand-700" %><%= @property.address_area %>
      </p>
    <% end %>

    <% chip = "inline-flex items-center gap-1.5 rounded-full border border-sand-200 bg-white px-3 py-1.5 text-base text-sand-700" %>
    <div class="mt-5 flex flex-wrap gap-2">
      <span class="<%= chip %>"><span class="text-sand-700"><%= icon :users, klass: "h-4 w-4" %></span><strong class="font-semibold text-sand-900"><%= @property.capacity %></strong> <%= t("property.guests") %></span>
      <span class="<%= chip %>"><span class="text-sand-700"><%= icon :home, klass: "h-4 w-4" %></span><strong class="font-semibold text-sand-900"><%= @property.bedrooms %></strong> <%= t("property.bedrooms") %></span>
      <span class="<%= chip %>"><span class="text-sand-700"><%= icon :bed, klass: "h-4 w-4" %></span><strong class="font-semibold text-sand-900"><%= @property.beds %></strong> <%= t("property.beds") %></span>
      <span class="<%= chip %>"><span class="text-sand-700"><%= icon :bath, klass: "h-4 w-4" %></span><strong class="font-semibold text-sand-900"><%= @property.bathrooms %></strong> <%= t("property.bathrooms") %></span>
      <span class="<%= chip %>"><span class="text-sand-700"><%= icon :calendar, klass: "h-4 w-4" %></span><%= t("property.min_stay") %> <strong class="font-semibold text-sand-900"><%= @property.min_nights %></strong> <%= t("property.min_stay_nights") %></span>
    </div>

    <% if @property.description.present? %>
      <div class="mt-8">
        <h2 class="font-display text-xl font-semibold text-sand-900"><%= t("property.about") %></h2>
        <div class="mt-3 max-w-none whitespace-pre-line leading-relaxed text-sand-700"><%= @property.description %></div>
      </div>
    <% end %>

    <%# --- Servicios / amenities --- %>
    <% amenities = @property.amenities.ordered.to_a %>
    <% if amenities.any? %>
      <div class="mt-10 border-t border-sand-200 pt-8">
        <h2 class="font-display text-xl font-semibold text-sand-900"><%= t("property.amenities_title") %></h2>
        <% visible = amenities.first(10) %>
        <% hidden = amenities.drop(10) %>
        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <% visible.each do |amenity| %>
            <div class="flex items-center gap-3 text-sand-700">
              <span class="text-sand-700"><%= amenity_icon(amenity.icon) %></span><%= amenity.label %>
            </div>
          <% end %>
        </div>
        <% if hidden.any? %>
          <details class="group mt-4">
            <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-xl border border-sand-300 px-4 py-2.5 text-base font-semibold text-sand-900 transition-colors hover:bg-sand-50">
              <%= t("property.show_all_amenities", count: amenities.size) %>
            </summary>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <% hidden.each do |amenity| %>
                <div class="flex items-center gap-3 text-sand-700">
                  <span class="text-sand-700"><%= amenity_icon(amenity.icon) %></span><%= amenity.label %>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>

    <div class="mt-10">
      <h2 class="font-display text-xl font-semibold text-sand-900"><%= t("property.availability") %></h2>
      <p class="mt-1 mb-4 text-base text-sand-500"><%= t("property.calendar_help") %></p>
      <div class="rounded-2xl border border-sand-200 bg-white p-5">
        <%= render "shared/calendar", property: @property, occupied: @occupied_dates, months: 2, selectable: true %>
        <div class="mt-3 flex items-center gap-3 text-base" data-date-range-target="controls" hidden>
          <span class="font-medium text-sand-700" data-date-range-target="summary"></span>
          <button type="button" data-action="date-range#clear" class="cursor-pointer text-sand-500 underline underline-offset-2 hover:text-sand-700"><%= t("property.clear") %></button>
        </div>
      </div>
    </div>

    <%# --- Evaluaciones / reviews --- %>
    <% if @property.rated? %>
      <div id="evaluaciones" class="mt-10 scroll-mt-24 border-t border-sand-200 pt-8">
        <h2 class="flex items-center gap-2 font-display text-2xl font-semibold text-sand-900">
          <%= icon :star, klass: "h-6 w-6", filled: true %>
          <%= rating_display(@property) %>
          <span class="text-sand-300">·</span>
          <%= t("property.reviews_count", count: @property.reviews_count) %>
        </h2>

        <%# Category breakdown — bars reflect the overall average %>
        <% pct = (@property.rating_cache.to_f / 5 * 100).round %>
        <div class="mt-8 grid gap-x-10 gap-y-3 border-y border-sand-200 py-6 sm:grid-cols-2 lg:grid-cols-3">
          <% t("property.review_categories").each do |_key, label| %>
            <div class="flex items-center justify-between gap-3">
              <span class="text-base text-sand-700"><%= label %></span>
              <span class="flex items-center gap-2">
                <span class="h-1 w-24 overflow-hidden rounded-full bg-sand-200"><span class="block h-full rounded-full bg-sand-900" style="width: <%= pct %>%"></span></span>
                <span class="w-7 text-right text-xs font-semibold text-sand-900"><%= rating_display(@property) %></span>
              </span>
            </div>
          <% end %>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <% @reviews.first(6).each do |review| %>
            <%= render "properties/review", review: review %>
          <% end %>
        </div>
        <% if @reviews.size > 6 %>
          <details class="mt-6">
            <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-xl border border-sand-300 px-4 py-2.5 text-base font-semibold text-sand-900 transition-colors hover:bg-sand-50">
              <%= t("property.show_all_reviews", count: @property.reviews_count) %>
            </summary>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <% @reviews.drop(6).each do |review| %>
                <%= render "properties/review", review: review %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>

    <%# --- Ubicación --- %>
    <% if @property.coordinates? %>
      <div class="mt-10">
        <h2 class="font-display text-xl font-semibold text-sand-900"><%= t("property.location") %></h2>
        <p class="mt-1 mb-4 text-base text-sand-500"><%= t("property.location_subtitle") %></p>
        <%= render "shared/map", title: @property.name, latitude: @property.latitude, longitude: @property.longitude, address: @property.address_area %>

        <% if @attraction_distances.present? %>
          <ul class="mt-4 divide-y divide-sand-200 overflow-hidden rounded-2xl border border-sand-200 bg-white">
            <% @attraction_distances.each do |entry, km| %>
              <li>
                <%= link_to guide_entry_path(entry), class: "group flex items-center justify-between gap-3 px-4 py-3 transition hover:bg-sand-50" do %>
                  <span class="flex min-w-0 items-center gap-2">
                    <span class="text-sand-700"><%= icon :pin, klass: "h-4 w-4" %></span>
                    <span class="truncate text-base font-medium text-sand-900 group-hover:text-brand-700"><%= entry.title %></span>
                  </span>
                  <span class="shrink-0 text-base font-semibold text-sand-500"><%= t("property.km_away", km: number_with_precision(km, precision: 1, strip_insignificant_zeros: true)) %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <%# --- Qué hacer cerca --- %>
    <% if @nearby_guide.any? %>
      <div class="mt-10">
        <h2 class="font-display text-xl font-semibold text-sand-900"><%= t("property.nearby_guide") %></h2>
        <p class="mt-1 mb-4 text-base text-sand-500"><%= t("property.nearby_guide_subtitle") %></p>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <% @nearby_guide.each do |entry| %>
            <%= link_to guide_entry_path(entry), class: "group flex items-center gap-3 rounded-2xl border border-sand-200 bg-white p-3 transition hover:border-brand-300 hover:shadow-sm" do %>
              <div class="h-16 w-16 shrink-0 overflow-hidden rounded-lg">
                <% if entry.cover_image.attached? %>
                  <%= image_tag entry.cover_image.variant(resize_to_fill: [ 128, 128 ]), alt: entry.title, loading: "lazy", class: "h-full w-full object-cover" %>
                <% else %>
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-400 to-brand-800 text-brand-50"><%= icon(entry.event? ? :ticket : :compass, klass: "h-5 w-5") %></div>
                <% end %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-sand-900 group-hover:text-brand-700"><%= entry.title %></p>
                <p class="truncate text-base text-sand-500"><%= entry.category&.name %><% if entry.area.present? %> · <%= entry.area %><% end %></p>
              </div>
              <span class="self-center text-brand-400 transition-transform group-hover:translate-x-0.5"><%= icon :arrow, klass: "h-4 w-4" %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# --- Booking box (sticky) --- %>
  <div class="lg:col-span-1">
    <div class="rounded-2xl border border-sand-200 bg-white p-6 shadow-[0_18px_44px_-28px_rgba(0,0,0,0.55)] lg:sticky lg:top-24">
      <p class="flex items-baseline gap-1.5 text-sand-900">
        <span class="font-display text-3xl font-semibold"><%= money(@property.base_price_cents, @property.currency) %></span>
        <span class="text-base text-sand-500"><%= t("units.per_night") %></span>
      </p>
      <% if @property.rated? %>
        <p class="mt-1 flex items-center gap-1 text-base text-sand-900">
          <%= icon :star, klass: "h-4 w-4", filled: true %><%= rating_display(@property) %>
          <span class="text-sand-300">·</span>
          <span class="text-sand-500"><%= t("property.reviews_count", count: @property.reviews_count) %></span>
        </p>
      <% end %>

      <%= form_with url: property_path(@property), method: :get, data: { turbo_frame: "quote", turbo_action: "advance", date_range_target: "form" }, class: "mt-5 space-y-3" do |form| %>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <%= form.label :check_in, t("property.arrival"), class: "kicker mb-1 block text-sand-500" %>
            <%= form.date_field :check_in, value: @check_in, min: Date.current, data: { date_range_target: "checkIn", action: "change->date-range#syncFromInputs" }, class: "w-full rounded-xl border border-sand-200 px-3 py-2 text-base focus:border-brand-500 focus:ring-1 focus:ring-brand-500" %>
          </div>
          <div>
            <%= form.label :check_out, t("property.departure"), class: "kicker mb-1 block text-sand-500" %>
            <%= form.date_field :check_out, value: @check_out, min: Date.current + 1, data: { date_range_target: "checkOut", action: "change->date-range#syncFromInputs" }, class: "w-full rounded-xl border border-sand-200 px-3 py-2 text-base focus:border-brand-500 focus:ring-1 focus:ring-brand-500" %>
          </div>
        </div>
        <div>
          <%= form.label :guests, t("property.guests_label"), class: "kicker mb-1 block text-sand-500" %>
          <%= form.number_field :guests, value: @guests, min: 1, max: @property.capacity, data: { action: "change->date-range#refresh" }, class: "w-full rounded-xl border border-sand-200 px-3 py-2 text-base focus:border-brand-500 focus:ring-1 focus:ring-brand-500" %>
        </div>
      <% end %>

      <%= turbo_frame_tag "quote" do %>
        <% if @quote.valid? %>
          <div class="mt-5 border-t border-sand-200 pt-5">
            <%= render "shared/price_breakdown", quote: @quote %>
            <% if @available %>
              <%= link_to new_booking_path(property_slug: @property.slug, check_in: @check_in, check_out: @check_out, guests: @guests),
                    data: { turbo_frame: "_top" },
                    class: btn_classes(:primary, "mt-4 w-full") do %>
                <%= t("property.book") %> <%= icon :arrow, klass: "h-4 w-4" %>
              <% end %>
            <% else %>
              <p class="mt-4 rounded-xl bg-rose-50 px-4 py-3 text-center text-base text-rose-700">
                <%= t("property.not_available") %>
              </p>
            <% end %>
          </div>
        <% else %>
          <p class="mt-5 border-t border-sand-200 pt-5 text-base text-sand-500">
            <%= t("property.pick_dates") %>
          </p>
        <% end %>
      <% end %>

      <p class="mt-4 flex items-start gap-2 text-base leading-relaxed text-sand-500">
        <span class="mt-0.5 text-sand-700"><%= icon :check, klass: "h-4 w-4" %></span>
        <%= t("property.reserve_note") %>
      </p>

      <%= render "shared/airbnb_cta", property: @property %>
    </div>
  </div>
</div>
