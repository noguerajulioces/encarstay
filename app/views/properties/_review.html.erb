<div class="rounded-2xl border border-sand-200 bg-white p-5">
  <div class="flex items-center gap-0.5 text-sand-700" aria-label="<%= t('property.rating_of_five', rating: review.rating) %>">
    <% review.rating.times do %><%= icon :star, klass: "h-4 w-4", filled: true %><% end %>
  </div>
  <% if review.body.present? %>
    <p class="mt-3 leading-relaxed text-sand-700"><%= review.body %></p>
  <% end %>
  <div class="mt-4 flex items-center gap-3">
    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-100 font-semibold text-brand-700"><%= review.reviewer_name.first.upcase %></span>
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold text-sand-900"><%= review.reviewer_name %></p>
      <p class="truncate text-xs text-sand-500">
        <%= [ review.reviewer_location, (l(review.stayed_on, format: :month_year) if review.stayed_on) ].compact.join(" · ") %>
      </p>
    </div>
  </div>
</div>
