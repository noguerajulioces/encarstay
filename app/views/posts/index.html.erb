<% content_for :title, t("blog.index_title") %>
<% content_for :description, t("blog.index_meta") %>
<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Blog",
    "name" => t("blog.index_title"),
    "description" => t("blog.index_meta"),
    "url" => posts_url,
    "inLanguage" => I18n.locale.to_s,
    "blogPost" => @posts.map { |post|
      {
        "@type" => "BlogPosting",
        "headline" => post.title,
        "url" => post_url(post),
        "datePublished" => post.published_at&.iso8601
      }.compact
    }
  }) %>
<% end %>

<section class="border-b border-sand-200 bg-gradient-to-b from-sand-100 to-sand-50">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
    <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-sand-700">
      <%= icon :sparkles, klass: "h-4 w-4" %> <%= t("blog.index_kicker") %>
    </p>
    <h1 class="mt-2 font-display text-4xl font-semibold text-sand-900 sm:text-5xl"><%= t("blog.index_title") %></h1>
    <p class="mt-3 max-w-xl text-lg text-sand-600"><%= t("blog.index_subtitle") %></p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 py-10">
  <% if @posts.any? %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @posts.each do |post| %>
        <%= render "shared/post_card", post: post %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-sand-300 px-6 py-16 text-center">
      <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-brand-50 text-brand-600"><%= icon :compass, klass: "h-6 w-6" %></span>
      <p class="mt-4 font-display text-xl font-semibold text-sand-900"><%= t("blog.none_title") %></p>
      <p class="mx-auto mt-1 max-w-md text-sand-500"><%= t("blog.none_subtitle") %></p>
    </div>
  <% end %>
</section>
