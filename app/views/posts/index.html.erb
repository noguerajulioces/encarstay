<% content_for :title, t("blog.index_title") %>
<% content_for :description, t("blog.index_meta") %>

<section class="border-b border-sand-200 bg-gradient-to-b from-sand-100 to-sand-50">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
    <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-brand-500">
      <%= icon :sparkles, klass: "h-4 w-4" %> <%= t("blog.index_kicker") %>
    </p>
    <h1 class="mt-2 font-display text-4xl font-semibold text-brand-900 sm:text-5xl"><%= t("blog.index_title") %></h1>
    <p class="mt-3 max-w-xl text-lg text-sand-600"><%= t("blog.index_subtitle") %></p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-5 py-10">
  <% if @posts.any? %>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @posts.each do |post| %>
        <%= render "shared/post_card", post: post %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-sand-300 py-16 text-center">
      <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-sand-100 text-sand-400"><%= icon :sparkles, klass: "h-6 w-6" %></span>
      <p class="mt-4 font-display text-xl font-semibold text-brand-900"><%= t("blog.none_title") %></p>
      <p class="mt-1 text-sand-500"><%= t("blog.none_subtitle") %></p>
    </div>
  <% end %>
</section>
