<% content_for :title, @post.title %>
<% content_for :description, (@post.meta_description.presence || @post.excerpt.presence || @post.title).to_s.truncate(160) %>
<% content_for :og_type, "article" %>
<% content_for(:og_image, rails_blob_url(@post.cover_image)) if @post.cover_image.attached? %>
<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "BlogPosting",
    "headline" => @post.title,
    "description" => (@post.meta_description.presence || @post.excerpt.presence || @post.title),
    "image" => (@post.cover_image.attached? ? rails_blob_url(@post.cover_image) : nil),
    "datePublished" => @post.published_at&.iso8601,
    "dateModified" => @post.updated_at.iso8601,
    "inLanguage" => I18n.locale.to_s,
    "author" => { "@type" => "Organization", "name" => t("site.name") },
    "publisher" => { "@type" => "Organization", "name" => t("site.name") },
    "mainEntityOfPage" => post_url(@post)
  }.compact) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => [
      { "@type" => "ListItem", "position" => 1, "name" => t("blog.index_title"), "item" => posts_url },
      { "@type" => "ListItem", "position" => 2, "name" => @post.title, "item" => post_url(@post) }
    ]
  }) %>
<% end %>

<article class="mx-auto max-w-3xl px-5 pt-6">
  <nav class="mb-4 flex items-center gap-1.5 text-sm text-sand-500">
    <%= link_to t("blog.index_title"), posts_path, class: "hover:text-brand-700" %>
    <span class="text-sand-300">/</span>
    <span class="truncate text-sand-700"><%= @post.title %></span>
  </nav>

  <header>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <% if @post.category.present? %>
        <span class="inline-flex items-center gap-1 rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-800">
          <%= icon(@post.category.icon.presence&.to_sym || :sparkles, klass: "h-3.5 w-3.5") %><%= @post.category.name %>
        </span>
      <% end %>
      <% if @post.published_at %>
        <time datetime="<%= @post.published_at.iso8601 %>" class="text-sand-500"><%= l @post.published_at.to_date, format: :long %></time>
      <% end %>
    </div>
    <h1 class="mt-3 font-display text-3xl font-semibold leading-tight text-brand-900 sm:text-4xl"><%= @post.title %></h1>
    <% if @post.excerpt.present? %>
      <p class="mt-3 text-xl leading-relaxed text-sand-600"><%= @post.excerpt %></p>
    <% end %>
  </header>

  <% if @post.cover_image.attached? %>
    <figure class="mt-6 overflow-hidden rounded-3xl">
      <%= image_tag @post.cover_image.variant(resize_to_limit: [ 1400, 900 ]), alt: @post.title, class: "w-full object-cover" %>
    </figure>
  <% end %>

  <div class="article-body mt-8"><%= @post.body %></div>
</article>

<% if @related.any? %>
  <section class="mx-auto max-w-6xl px-5 py-12">
    <h2 class="mb-6 font-display text-2xl font-semibold text-brand-900"><%= t("blog.more_posts") %></h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @related.each do |post| %>
        <%= render "shared/post_card", post: post %>
      <% end %>
    </div>
  </section>
<% end %>
