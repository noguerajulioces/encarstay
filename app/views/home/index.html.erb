<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Organization",
    "name" => t("site.name"),
    "url" => root_url,
    "description" => t("home.org_description")
  }) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "WebSite",
    "name" => t("site.name"),
    "url" => root_url
  }) %>
<% end %>

<%# ===== Hero ===== %>
<section class="relative overflow-hidden bg-sand-50">
  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 pb-16 pt-12 sm:pb-20 sm:pt-16 lg:grid-cols-2 lg:gap-14">
    <div>
      <p class="kicker text-brand-700"><%= t("home.hero_kicker") %></p>
      <h1 class="mt-3 font-display text-[2.375rem] font-bold leading-[1.08] tracking-tight text-sand-900 sm:text-[3.875rem]">
        <%= t("home.hero_title_main") %>
        <em class="not-italic whitespace-nowrap text-brand-600"><%= t("home.hero_title_accent") %></em>
      </h1>
      <p class="mt-5 max-w-xl text-xl leading-relaxed text-sand-600">
        <%= t("home.hero_subtitle") %>
      </p>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-base text-sand-600">
        <span class="inline-flex items-center gap-2"><%= icon :check, klass: "h-4 w-4 text-brand-500" %> <%= t("home.trust_direct") %></span>
        <span class="inline-flex items-center gap-2"><%= icon :check, klass: "h-4 w-4 text-brand-500" %> <%= t("home.trust_no_fees") %></span>
        <span class="inline-flex items-center gap-2"><%= icon :check, klass: "h-4 w-4 text-brand-500" %> <%= t("home.trust_local") %></span>
      </div>

      <div class="mt-9">
        <a href="#alojamientos" class="<%= btn_classes(:primary) %>">
          <%= t("home.hero_cta") %> <%= icon :arrow, klass: "h-4 w-4" %>
        </a>
      </div>
    </div>

    <div>
      <%= render "home/hero_art" %>
    </div>
  </div>
</section>

<%# ===== Alojamientos ===== %>
<section id="alojamientos" class="scroll-mt-24 py-14 sm:py-20">
  <div class="mx-auto max-w-6xl px-5">
  <%= render "shared/section_heading",
        kicker: t("home.properties_kicker"),
        title: t("home.properties_title"),
        subtitle: t("home.properties_subtitle"),
        link_label: t("home.see_all"), link_path: properties_path %>

  <%# Verificador de disponibilidad: fechas + huéspedes al servicio del catálogo %>
  <div class="mt-10 max-w-2xl">
    <p class="mb-2 text-base font-medium text-sand-600"><%= t("home.availability_hint") %></p>
    <%= render "shared/search_form", search: @search %>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    <% @properties.each do |property| %>
      <%= render "shared/property_card", property: property %>
    <% end %>
  </div>
  </div>
</section>

<%# ===== Guía de la ciudad ===== %>
<% if @categories.any? %>
  <section class="bg-brand-50 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-5">
    <%= render "shared/section_heading",
          kicker: t("home.guide_kicker"),
          title: t("home.guide_title"),
          subtitle: t("home.guide_subtitle"),
          link_label: t("home.see_guide"), link_path: attractions_path %>
    <div class="mt-8"><%= render "shared/category_tiles", categories: @categories, kind: "attractions" %></div>
    </div>
  </section>
<% end %>

<%# ===== Consulta de reserva ===== %>
<section class="mx-auto max-w-6xl px-5 pt-14 sm:pt-20">
  <%= render "shared/reservation_lookup" %>
</section>
