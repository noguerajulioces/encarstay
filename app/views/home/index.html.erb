<% content_for :seo do %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "Organization",
    "name" => t("site.name"),
    "url" => root_url,
    "description" => t("home.org_description")
  }) %>
  <%= json_ld({
    "@context" => "https://schema.org",
    "@type" => "WebSite",
    "name" => t("site.name"),
    "url" => root_url
  }) %>
<% end %>

<section class="rounded-3xl bg-gradient-to-br from-emerald-800 to-emerald-950 text-white px-6 py-12 sm:px-12 sm:py-16">
  <div class="max-w-2xl">
    <p class="text-emerald-300 font-medium"><%= t("home.hero_kicker") %></p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold leading-tight">
      <%= t("home.hero_title") %>
    </h1>
    <p class="mt-3 text-emerald-100">
      <%= t("home.hero_subtitle") %>
    </p>
  </div>

  <div class="mt-8 bg-white rounded-2xl p-4 sm:p-5 shadow-lg">
    <%= render "shared/search_form", search: @search %>
  </div>
</section>

<section class="mt-12">
  <h2 class="text-2xl font-semibold text-stone-900"><%= t("home.properties_title") %></h2>
  <p class="text-stone-500 mt-1"><%= t("home.properties_subtitle") %></p>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @properties.each do |property| %>
      <%= render "shared/property_card", property: property %>
    <% end %>
  </div>
</section>

<section class="mt-12">
  <%= render "shared/reservation_lookup" %>
</section>
