    <%# Palmera baja %>
    <path d="M885 415 C895 370 890 320 872 275" stroke-width="9" pathlength="1" />
    <g stroke-width="7">
      <path d="M872 275 C845 262 815 262 795 278" pathlength="1" />
      <path d="M872 275 C842 250 810 244 788 254" pathlength="1" />
      <path d="M872 275 C852 232 826 220 800 222" pathlength="1" />
