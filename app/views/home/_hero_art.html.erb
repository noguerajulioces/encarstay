    <path d="M842 160 H988" class="stroke-sand-50" stroke-width="11" />
  </g>

  <%# Playa y orilla %>
  <path d="M755 398 Q880 428 1040 436 L1040 620 L600 620 Q690 585 720 520 Q740 452 755 398 Z"
        class="fill-brand-100 hero-art-beach" />
  <path d="M755 398 Q880 428 1040 436"
        class="stroke-brand-300 hero-art-river" stroke-width="5" stroke-linecap="round" pathlength="1" />

  <%# Cables %>
  <g class="stroke-brand-300 hero-art-cables" stroke-width="3.5" stroke-linecap="round">
    <path d="M300 112 L95 384"  pathlength="1" />
