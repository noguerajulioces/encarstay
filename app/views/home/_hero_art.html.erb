    <path d="M300 112 L235 384" pathlength="1" />
    <path d="M300 112 L365 384" pathlength="1" />
    <path d="M300 112 L435 384" pathlength="1" />
    <path d="M300 112 L505 384" pathlength="1" />
    <path d="M640 112 L435 384" pathlength="1" />
    <path d="M640 112 L505 384" pathlength="1" />
    <path d="M640 112 L575 384" pathlength="1" />
    <path d="M640 112 L705 384" pathlength="1" />
    <path d="M640 112 L775 384" pathlength="1" />
    <path d="M640 112 L845 384" pathlength="1" />
