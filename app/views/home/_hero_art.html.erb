<%# El puente San Roque González, el Paraná y la costanera, en el trazo del
    logo. La animación de dibujado vive en application.css (.hero-art-*);
    pathlength="1" es requisito del stroke-dashoffset. %>
<svg viewBox="0 0 1100 620" fill="none" role="img"
     aria-label="<%= t("home.hero_image_alt") %>"
     class="hero-art h-auto w-full">
  <%# Sol %>
  <g class="hero-art-sun">
    <circle cx="915" cy="128" r="58" class="fill-brand-200" />
