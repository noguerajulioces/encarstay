  <%# Torres y tablero %>
  <g class="stroke-brand-600 hero-art-bridge" stroke-width="15" stroke-linecap="round">
    <path d="M50 386 H845" pathlength="1" />
    <path d="M300 96 V452" pathlength="1" />
    <path d="M640 96 V452" pathlength="1" />
